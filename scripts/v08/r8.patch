--- /dev/null
+++ b/runtime/open-shaders/src/Features/Upscaling/NeuralRendering/FeatherGeometry.h
@@ -0,0 +1,84 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace NeuralRendering::FeatherGeometry
+{
+	struct Axis
+	{
+		float begin = 0, end = 0, extent = 0, packedBegin = 0;
+		float pitch = 1, compression = 1, power = 2, packedExtent = 0;
+	};
+	struct Mapping { Axis x, y; };
+	static_assert(sizeof(Mapping) == 64);
+
+	/** Expand around the current gaze centre without changing the selected crop. */
+	template<class Region> Region Expand(Region region, float percent)
+	{
+		const float factor = 1.0f + std::clamp(percent, 0.0f, 100.0f) * 0.01f;
+		const float width = std::min(1.0f, region.w * factor);
+		const float height = std::min(1.0f, region.h * factor);
+		region.x = std::clamp(region.x + (region.w - width) * 0.5f, 0.0f, 1.0f - width);
+		region.y = std::clamp(region.y + (region.h - height) * 0.5f, 0.0f, 1.0f - height);
+		region.w = width; region.h = height;
+		return region;
+	}
+
+	/** Keep the centre on the full-eye model lattice and compress only its exterior. */
+	inline Axis MakeAxis(float begin, float end, float extent, float origin, float pitch, float compression, float power)
+	{
+		Axis axis;
+		axis.pitch = std::clamp(pitch, 1.0f, 100.0f / 70.0f);
+		axis.compression = std::clamp(compression, 1.0f, 20.0f);
+		axis.power = std::clamp(power, 1.0f, 4.0f);
+		const float phase = std::floor((origin + begin) / axis.pitch) * axis.pitch - origin - begin;
+		axis.extent = extent;
+		axis.begin = std::clamp(begin + phase, 0.0f, extent);
+		axis.end = std::clamp(end + phase, axis.begin, extent);
+		const float divisor = 1.0f + (axis.compression - 1.0f) / (axis.power + 1.0f);
+		axis.packedBegin = std::ceil(axis.begin / (divisor * axis.pitch));
+		axis.packedExtent = std::ceil(axis.packedBegin + (axis.end - axis.begin) / axis.pitch +
+			(extent - axis.end) / (divisor * axis.pitch));
+		return axis;
+	}
+
+	inline float ExteriorToPhysical(float distance, float length, const Axis& axis)
+	{
+		if (length <= 0) return 0;
+		const float a = (axis.compression - 1.0f) / (axis.power + 1.0f);
+		const float q = distance * axis.pitch * (1.0f + a) / length;
+		return length * (q + a * std::pow(std::max(q, 0.0f), axis.power + 1.0f)) / (1.0f + a);
+	}
+	inline float ExteriorToModel(float distance, float length, const Axis& axis)
+	{
+		if (length <= 0) return 0;
+		const float a = (axis.compression - 1.0f) / (axis.power + 1.0f);
+		const float t = std::clamp(distance / length, 0.0f, 1.0f);
+		float q = t, low = 0, high = 1;
+		for (unsigned i = 0; i < 10; ++i) {
+			const float value = (q + a * std::pow(q, axis.power + 1.0f)) / (1.0f + a) - t;
+			if (std::abs(value) < 1e-7f) break;
+			if (value > 0) high = q; else low = q;
+			const float derivative = (1.0f + (axis.compression - 1.0f) * std::pow(q, axis.power)) / (1.0f + a);
+			const float candidate = q - value / derivative;
+			q = candidate >= low && candidate <= high ? candidate : (low + high) * 0.5f;
+		}
+		return length * q / ((1.0f + a) * axis.pitch);
+	}
+	inline float ToPhysical(float model, const Axis& axis)
+	{
+		const float end = axis.packedBegin + (axis.end - axis.begin) / axis.pitch;
+		if (model < axis.packedBegin) return axis.begin - ExteriorToPhysical(axis.packedBegin - model, axis.begin, axis);
+		if (model > end) return axis.end + ExteriorToPhysical(model - end, axis.extent - axis.end, axis);
+		return axis.begin + (model - axis.packedBegin) * axis.pitch;
+	}
+	inline float ToModel(float physical, const Axis& axis)
+	{
+		if (physical < axis.begin) return axis.packedBegin - ExteriorToModel(axis.begin - physical, axis.begin, axis);
+		if (physical > axis.end) return axis.packedBegin + (axis.end - axis.begin) / axis.pitch +
+			ExteriorToModel(physical - axis.end, axis.extent - axis.end, axis);
+		return axis.packedBegin + (physical - axis.begin) / axis.pitch;
+	}
+}
