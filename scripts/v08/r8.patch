diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherGuidesCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherGuidesCS.hlsl
new file mode 100644
index 0000000..c9eb764
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherGuidesCS.hlsl
@@ -0,0 +1,53 @@
+#define FEATHER_LUT_SLOT t4
+#include "FeatherMap.hlsli"
+cbuffer FeatherGuides : register(b0)
+{
+	uint4 gCurrent, gPrevious, gLayout;
+	float4 gLeftOrigin, gRightOrigin, gMotionScale;
+	uint4 gFlags;
+	float4 gSourceGuides, gLeftPhase, gRightPhase;
+	FeatherMapping gLeft, gRight, gPreviousLeft, gPreviousRight;
+};
+Texture2D<float2> gLeftMotion : register(t0);
+Texture2D<float2> gRightMotion : register(t1);
+Texture2D<float> gLeftDepth : register(t2);
+Texture2D<float> gRightDepth : register(t3);
+RWTexture2D<float2> gMotion : register(u0);
+RWTexture2D<float> gDepth : register(u1);
+float StableDelta(float physical, float previousPhysical, float sceneShift, FeatherAxis current, FeatherAxis previous, float fallback)
+{
+	if (physical >= current.bounds.x && physical <= current.bounds.y &&
+		previousPhysical >= previous.bounds.x && previousPhysical <= previous.bounds.y && current.curve.x == previous.curve.x)
+		return previous.bounds.w - current.bounds.w + (current.bounds.x - previous.bounds.x + sceneShift) / current.curve.x;
+	return fallback;
+}
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	uint rightStart = gCurrent.z + gFlags.y;
+	if (id.x >= rightStart + gCurrent.z || id.y >= gCurrent.w) return;
+	bool right = id.x >= rightStart;
+	uint x = right ? id.x - rightStart : min(id.x, gCurrent.z-1);
+	FeatherMapping current = gLeft;
+	FeatherMapping previous = gPreviousLeft;
+	if (right) { current = gRight; previous = gPreviousRight; }
+	float4 origin = right ? gRightOrigin : gLeftOrigin;
+	float2 currentModel = (float2(x,id.y)+0.5) * float2(gCurrent.xy) / float2(gCurrent.zw);
+	float2 currentColor = FeatherPhysical(currentModel, current);
+	uint2 pixel = uint2(clamp(currentColor * gSourceGuides.xy / float2(gLayout.xy), 0.0, gSourceGuides.xy-1.0));
+	float2 raw = right ? gRightMotion.Load(int3(pixel,0)) : gLeftMotion.Load(int3(pixel,0));
+	gDepth[id.xy] = right ? gRightDepth.Load(int3(pixel,0)) : gLeftDepth.Load(int3(pixel,0));
+	float2 previousColor = currentColor + origin.xy - origin.zw + raw * gMotionScale.xy;
+	float2 previousModel = FeatherModel(previousColor, previous);
+	bool sourceValid = all(isfinite(raw)) && !any(asuint(raw) == 0x00800000u);
+	bool valid = gFlags.x != 0 && sourceValid && all(previousColor >= 0.0) &&
+		all(previousColor <= float2(gPrevious.zw)) && all(previousModel >= 0.5-0.001) &&
+		all(previousModel <= float2(gPrevious.xy)-0.5+0.001);
+	float2 delta = previousModel - currentModel;
+	float2 shift = origin.xy - origin.zw + raw * gMotionScale.xy;
+	delta.x = StableDelta(currentColor.x, previousColor.x, shift.x, current.x, previous.x, delta.x);
+	delta.y = StableDelta(currentColor.y, previousColor.y, shift.y, current.y, previous.y, delta.y);
+	if (right) delta.x += float(gPrevious.x + gLayout.w) - float(gCurrent.x + gLayout.z);
+	float2 rejection = float2(0.0, 2.0*gFlags.z/gMotionScale.w);
+	gMotion[id.xy] = !sourceValid ? raw : valid ? delta/gMotionScale.zw : rejection;
+}
diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherMap.hlsli b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherMap.hlsli
new file mode 100644
index 0000000..74b45b3
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherMap.hlsli
@@ -0,0 +1,41 @@
+#ifndef FEATHER_LUT_SLOT
+#define FEATHER_LUT_SLOT t3
+#endif
+Texture1D<float> gFeatherInverse : register(FEATHER_LUT_SLOT);
+SamplerState gFeatherSampler : register(s0);
+
+struct FeatherAxis { float4 bounds; float4 curve; };
+struct FeatherMapping { FeatherAxis x; FeatherAxis y; };
+
+float FeatherToPhysical(float model, FeatherAxis axis)
+{
+	float end = axis.bounds.w + (axis.bounds.y - axis.bounds.x) / axis.curve.x;
+	bool left = model < axis.bounds.w;
+	if (!left && model <= end) return axis.bounds.x + (model - axis.bounds.w) * axis.curve.x;
+	float length = left ? axis.bounds.x : axis.bounds.z - axis.bounds.y;
+	float a = (axis.curve.y - 1.0) / (axis.curve.z + 1.0);
+	float distance = left ? axis.bounds.w - model : model - end;
+	float q = distance * axis.curve.x * (1.0 + a) / max(length, 1e-6);
+	float physical = length * (q + a * pow(max(q, 0.0), axis.curve.z + 1.0)) / (1.0 + a);
+	return left ? axis.bounds.x - physical : axis.bounds.y + physical;
+}
+float FeatherToModel(float physical, FeatherAxis axis)
+{
+	bool left = physical < axis.bounds.x;
+	if (!left && physical <= axis.bounds.y) return axis.bounds.w + (physical - axis.bounds.x) / axis.curve.x;
+	float length = left ? axis.bounds.x : axis.bounds.z - axis.bounds.y;
+	float distance = left ? axis.bounds.x - physical : physical - axis.bounds.y;
+	float a = (axis.curve.y - 1.0) / (axis.curve.z + 1.0);
+	float t = saturate(distance / max(length, 1e-6));
+	float q = gFeatherInverse.SampleLevel(gFeatherSampler, (t * 4096.0 + 0.5) / 4097.0, 0);
+	float packed = length * q / ((1.0 + a) * axis.curve.x);
+	return left ? axis.bounds.w - packed : axis.bounds.w + (axis.bounds.y - axis.bounds.x) / axis.curve.x + packed;
+}
+float2 FeatherPhysical(float2 model, FeatherMapping map)
+{
+	return float2(FeatherToPhysical(model.x, map.x), FeatherToPhysical(model.y, map.y));
+}
+float2 FeatherModel(float2 physical, FeatherMapping map)
+{
+	return float2(FeatherToModel(physical.x, map.x), FeatherToModel(physical.y, map.y));
+}
diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherModelCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherModelCS.hlsl
new file mode 100644
index 0000000..d5f1947
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/FeatherModelCS.hlsl
@@ -0,0 +1,63 @@
+#include "FeatherMap.hlsli"
+cbuffer FeatherModel : register(b0)
+{
+	uint4 gSize;
+	FeatherMapping gMap;
+	float4 gOptions; // zero=pack, positive=resolve strength; exterior strength, outer fade, luma limit
+};
+Texture2D<float4> gProxy : register(t0);
+Texture2D<float4> gModel : register(t1);
+Texture2D<float4> gOriginal : register(t2);
+RWTexture2D<float4> gTarget : register(u0);
+
+float4 ValidSample(Texture2D<float4> source, float2 pixel, float2 valid)
+{
+	uint width, height; source.GetDimensions(width, height);
+	return source.SampleLevel(gFeatherSampler, clamp(pixel, 0.5, valid - 0.5) / float2(width, height), 0);
+}
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= gSize.xy)) return;
+	if (gOptions.x == 0.0) {
+		float2 begin = FeatherPhysical(float2(id.xy), gMap);
+		float2 end = FeatherPhysical(float2(id.xy + 1u), gMap);
+		float2 footprint = max(end - begin, 1e-5);
+		float4 sum = 0;
+		if (all(footprint <= 2.0)) {
+			int2 first = int2(floor(begin)), last = int2(ceil(end)) - 1;
+			[loop] for (int y = first.y; y <= last.y; ++y)
+				[loop] for (int x = first.x; x <= last.x; ++x) {
+					float weight = max(0.0, min(end.x, float(x+1)) - max(begin.x, float(x))) *
+						max(0.0, min(end.y, float(y+1)) - max(begin.y, float(y)));
+					sum += gProxy.Load(int3(clamp(int2(x,y), int2(0,0), int2(gSize.zw)-1),0)) * weight;
+				}
+			gTarget[id.xy] = sum / (footprint.x * footprint.y);
+		} else {
+			uint2 samples = uint2(clamp(ceil(footprint), 1.0, 4.0));
+			[loop] for (uint y = 0; y < samples.y; ++y)
+				[loop] for (uint x = 0; x < samples.x; ++x)
+					sum += ValidSample(gProxy, begin + (float2(x,y)+0.5) * footprint / float2(samples), float2(gSize.zw));
+			gTarget[id.xy] = sum / float(samples.x * samples.y);
+		}
+		return;
+	}
+	float2 physical = float2(id.xy) + 0.5;
+	float2 model = FeatherModel(physical, gMap);
+	float3 residual = ValidSample(gModel, model, float2(gSize.zw)).rgb - ValidSample(gProxy, model, float2(gSize.zw)).rgb;
+	float2 coreBegin = float2(gMap.x.bounds.x, gMap.y.bounds.x);
+	float2 coreEnd = float2(gMap.x.bounds.y, gMap.y.bounds.y);
+	float2 extent = float2(gMap.x.bounds.z, gMap.y.bounds.z);
+	float2 outer = max((coreBegin - physical) / max(coreBegin, 1e-6), (physical - coreEnd) / max(extent - coreEnd, 1e-6));
+	float distance = saturate(max(outer.x, outer.y));
+	float exterior = smoothstep(0.0, 0.05, distance);
+	float weight = lerp(1.0, gOptions.y, exterior) * (1.0 - smoothstep(1.0 - gOptions.z, 1.0, distance));
+	float4 original = gOriginal.Load(int3(id.xy,0));
+	if (gOptions.w > 1.0) {
+		float originalLuma = dot(original.rgb, float3(0.2126,0.7152,0.0722));
+		float residualLuma = dot(residual, float3(0.2126,0.7152,0.0722));
+		float maxDelta = max(originalLuma * max(gOptions.w-1.0, 0.05), 0.01);
+		if (abs(residualLuma) > maxDelta) residual *= maxDelta / max(abs(residualLuma),1e-6);
+	}
+	gTarget[id.xy] = float4(max(original.rgb + residual * weight * gOptions.x, 0.0), original.a);
+}
