--- /dev/null
+++ b/runtime/open-shaders/src/Features/Upscaling/NeuralRendering/FeatherPlan.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include "FeatherGeometry.h"
+#include "../FoveatedRender/CropGeometry.h"
+
+namespace NeuralRendering::FeatherPlan
+{
+	using namespace FoveatedRenderImpl::CropGeometry;
+
+	template<class Region>
+	struct Plan
+	{
+		std::array<Region, 2> regions;
+		FramePlan core;
+		FramePlan sr;
+		bool expanded = false;
+	};
+
+	inline bool Contains(const PixelRect& outer, const PixelRect& inner)
+	{
+		return inner.width && inner.height && outer.x <= inner.x && outer.y <= inner.y &&
+			outer.x + outer.width >= inner.x + inner.width && outer.y + outer.height >= inner.y + inner.height;
+	}
+
+	/** @brief Quantize the selected and expanded SR regions on the same render grid. */
+	template<class Region>
+	Plan<Region> Make(const Region& left, const Region& right, bool requested, float expansion,
+		std::uint32_t inputWidth, std::uint32_t inputHeight, std::uint32_t outputWidth, std::uint32_t outputHeight)
+	{
+		Plan<Region> plan{ { left, right }, {}, {}, requested && expansion > 0.0f &&
+			!(left.w >= 0.999f && left.h >= 0.999f && right.w >= 0.999f && right.h >= 0.999f) };
+		plan.core = { inputWidth, inputHeight, outputWidth, outputHeight, {} };
+		plan.sr = plan.core;
+		for (unsigned eye = 0; eye < 2; ++eye) {
+			const auto& r = plan.regions[eye];
+			plan.core.eyes[eye] = MakeEyePlan(r.x, r.y, r.w, r.h, inputWidth, inputHeight, outputWidth, outputHeight);
+			if (plan.expanded)
+				plan.regions[eye] = FeatherGeometry::Expand(r, expansion);
+			const auto& sr = plan.regions[eye];
+			plan.sr.eyes[eye] = MakeEyePlan(sr.x, sr.y, sr.w, sr.h, inputWidth, inputHeight, outputWidth, outputHeight);
+		}
+		if (!plan.expanded || !inputWidth || !inputHeight || !outputWidth || !outputHeight)
+			return plan;
+
+		std::uint32_t width = 0, height = 0;
+		for (unsigned eye = 0; eye < 2; ++eye) {
+			auto& sr = plan.sr.eyes[eye].input;
+			const auto& core = plan.core.eyes[eye].input;
+			const auto rightEdge = std::max(sr.x + sr.width, core.x + core.width);
+			const auto bottomEdge = std::max(sr.y + sr.height, core.y + core.height);
+			sr.x = std::min(sr.x, core.x);
+			sr.y = std::min(sr.y, core.y);
+			sr.width = rightEdge - sr.x;
+			sr.height = bottomEdge - sr.y;
+			width = std::max(width, sr.width);
+			height = std::max(height, sr.height);
+		}
+		for (unsigned attempt = 0; attempt < 3; ++attempt) {
+			bool growWidth = false, growHeight = false;
+			for (unsigned eye = 0; eye < 2; ++eye) {
+				auto input = plan.sr.eyes[eye].input;
+				input.x = std::min(input.x, inputWidth - width);
+				input.y = std::min(input.y, inputHeight - height);
+				input.width = width;
+				input.height = height;
+				plan.sr.eyes[eye] = MakeEyePlan(input, inputWidth, inputHeight, outputWidth, outputHeight);
+				const auto& output = plan.sr.eyes[eye].output;
+				const auto& core = plan.core.eyes[eye].output;
+				growWidth |= output.x > core.x || output.x + output.width < core.x + core.width;
+				growHeight |= output.y > core.y || output.y + output.height < core.y + core.height;
+			}
+			if (!growWidth && !growHeight)
+				break;
+			width = std::min(inputWidth, width + (growWidth ? 1u : 0u));
+			height = std::min(inputHeight, height + (growHeight ? 1u : 0u));
+		}
+		return plan;
+	}
+
+	/** @brief Build the compressed model mapping from the actual SR output and selected core. */
+	inline FeatherGeometry::Mapping Mapping(const EyePlan& core, const EyePlan& sr, float pitch, float compression, float power)
+	{
+		return {
+			FeatherGeometry::MakeAxis(float(core.output.x) - sr.output.x, float(core.output.x + core.output.width) - sr.output.x,
+				float(sr.output.width), float(sr.output.x), pitch, compression, power),
+			FeatherGeometry::MakeAxis(float(core.output.y) - sr.output.y, float(core.output.y + core.output.height) - sr.output.y,
+				float(sr.output.height), float(sr.output.y), pitch, compression, power)
+		};
+	}
+}
