+	/** @brief Protect quantized render pixel bounds plus two pixels for jitter/sampling. */
+	template<class Profile>
+	bool ProtectRenderRectangles(Profile& profile, const FoveatedRenderImpl::CropGeometry::FramePlan& plan)
+	{
+		if (!plan.fullInputWidth || !plan.fullInputHeight)
+			return false;
+		struct Region { float x, y, w, h; };
+		const auto region = [&](const auto& rect) {
+			const auto left = rect.x > 2 ? rect.x - 2 : 0u;
+			const auto top = rect.y > 2 ? rect.y - 2 : 0u;
+			const auto right = std::min(plan.fullInputWidth, rect.x + rect.width + 2u);
+			const auto bottom = std::min(plan.fullInputHeight, rect.y + rect.height + 2u);
+			return Region{ float(left) / plan.fullInputWidth, float(top) / plan.fullInputHeight,
+				float(right - left) / plan.fullInputWidth, float(bottom - top) / plan.fullInputHeight };
+		};
+		return ProtectRectangles(profile, region(plan.eyes[0].input), region(plan.eyes[1].input));
+	}
+
+	/** @brief Estimate zero-detail screen area; this is not a GPU timing measurement. */
+	template<class Profile>
+	float SkippedFraction(const Profile& profile, bool hardCutoff)
+	{
+		if (!profile.available)
+			return 0.0f;
+		constexpr unsigned grid = 64;
+		unsigned skipped = 0;
+		const float radiusX = profile.coverageScale * profile.centerHorizontalScale * 0.5f;
+		const float radiusY = profile.coverageScale * 0.5f;
+		const float feather = FoveatedCommon::kCenterFeather / std::min(radiusX, radiusY);
+		for (unsigned eye = 0; eye < 2; ++eye)
+			for (unsigned y = 0; y < grid; ++y)
+				for (unsigned x = 0; x < grid; ++x) {
+					const float nx = ((float(x) + 0.5f) / grid - 0.5f - profile.centerOffsets[eye].x) / radiusX;
+					const float ny = ((float(y) + 0.5f) / grid - 0.5f - profile.centerOffsets[eye].y) / radiusY;
+					const float distance = std::sqrt(std::sqrt(nx * nx * nx * nx + ny * ny * ny * ny));
+					skipped += distance > (hardCutoff ? 1.0f : 1.0f + feather) ? 1u : 0u;
+				}
+		return float(skipped) / (2u * grid * grid);
+	}
 }
