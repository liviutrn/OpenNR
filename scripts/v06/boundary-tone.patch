diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneSmoothCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneSmoothCS.hlsl
new file mode 100644
index 0000000..b9330ac
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneSmoothCS.hlsl
@@ -0,0 +1,44 @@
+cbuffer OutsideToneMap : register(b0)
+{
+	uint2 gCropSize;
+	uint2 gCropOrigin;
+	float2 gRadii;
+	float2 gInset;
+	float gLimitStops;
+	float gOffsetLimit;
+	float gSampleWidth;
+	uint gOval;
+	float gSmoothing;
+	uint gMode;
+	float2 gPadding;
+};
+Texture2DArray<float4> gInput : register(t0);
+RWTexture2DArray<float4> gOutput : register(u0);
+
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= uint2(16,16))) return;
+	const int2 p = int2(id.xy);
+	const float4 gain = gInput.Load(int4(p,0,0));
+	const float4 bias = gInput.Load(int4(p,1,0));
+	const float4 reference = gInput.Load(int4(p,2,0));
+	float3 sumGain = 0.0, sumBias = 0.0;
+	float total = 0.0;
+	[unroll] for (int y = -1; y <= 1; ++y) {
+		[unroll] for (int x = -1; x <= 1; ++x) {
+			const int2 q = clamp(p + int2(x,y),int2(0,0),int2(15,15));
+			const float4 otherGain = gInput.Load(int4(q,0,0));
+			const float3 difference = gInput.Load(int4(q,2,0)).rgb - reference.rgb;
+			const float spatial = (x == 0 ? 2.0 : 1.0) * (y == 0 ? 2.0 : 1.0);
+			const float weight = spatial * otherGain.a / (1.0 + 64.0 * dot(difference,difference));
+			sumGain += otherGain.rgb * weight;
+			sumBias += gInput.Load(int4(q,1,0)).rgb * weight;
+			total += weight;
+		}
+	}
+	const float amount = total > 0.0 ? gSmoothing : 0.0;
+	gOutput[uint3(id.xy,0)] = float4(lerp(gain.rgb,sumGain / max(total,0.00001),amount),gain.a);
+	gOutput[uint3(id.xy,1)] = float4(lerp(bias.rgb,sumBias / max(total,0.00001),amount),bias.a);
+	gOutput[uint3(id.xy,2)] = reference;
+}
