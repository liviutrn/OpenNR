diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamApplyCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamApplyCS.hlsl
new file mode 100644
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamApplyCS.hlsl
@@ -0,0 +1,110 @@
+cbuffer OutsideSeamApply : register(b0)
+{
+	uint2 gOrigin;
+	uint2 gExtent;
+	uint2 gCropOrigin;
+	uint2 gCropSize;
+	float2 gRadii;
+	float2 gInset;
+	float gWidth;
+	float gBrightness;
+	float gColor;
+	float gCurve;
+	float gDither;
+	float gBoundaryRamp;
+	float gSampleInset;
+	uint gOval;
+	float gLimitStops;
+	float gOffsetLimit;
+	float gEdgeProtection;
+	uint gMode;
+	float gContrast;
+	float gNonlinear;
+	float gPlateau;
+	float gBlackProtection;
+	uint2 gInnerOrigin;
+	uint2 gInnerSize;
+	uint gTopCount;
+	uint gSideCount;
+	uint gTotalPixels;
+	uint gPadding;
+	float gContrastReach;
+	float3 gSeamPadding;
+};
+Texture2DArray<float4> gTone : register(t0);
+RWTexture2D<float4> gDestination : register(u0);
+SamplerState gLinearClamp : register(s0);
+static const float3 kLuma = float3(0.2126,0.7152,0.0722);
+
+[numthreads(64,1,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	uint index = id.x + id.y * 16384u;
+	if (index >= gTotalPixels) return;
+	uint2 coordinate;
+	if (index < gTopCount) coordinate = uint2(index % gExtent.x,index / gExtent.x);
+	else if (index < gTopCount + gSideCount) {
+		index -= gTopCount;
+		const uint sideWidth = gExtent.x - gInnerSize.x;
+		uint x = index % sideWidth;
+		if (x >= gInnerOrigin.x) x += gInnerSize.x;
+		coordinate = uint2(x,gInnerOrigin.y + index / sideWidth);
+	} else {
+		index -= gTopCount + gSideCount;
+		coordinate = uint2(index % gExtent.x,gInnerOrigin.y + gInnerSize.y + index / gExtent.x);
+	}
+	const uint2 pixel = coordinate + gOrigin;
+	const float2 local = float2(pixel) - float2(gCropOrigin);
+	float distance;
+	float2 boundary;
+	if (gOval != 0u) {
+		const float2 offset = local + 0.5 - float2(gCropSize) * 0.5;
+		const float radius = length(offset / gRadii);
+		if (radius <= 1.0) return;
+		distance = length(offset) * (1.0 - 1.0 / radius);
+		boundary = offset / radius + float2(gCropSize) * 0.5;
+	} else {
+		const float2 last = float2(gCropSize) - 1.0 - gInset;
+		if (all(local >= gInset) && all(local <= last)) return;
+		const float2 nearest = clamp(local,gInset,last);
+		distance = length(local - nearest);
+		boundary = nearest + 0.5;
+	}
+	if (distance >= gWidth || distance <= 0.0) return;
+	const float normalized = saturate(distance / gWidth);
+	float t = pow(saturate((normalized - gPlateau) / max(1.0 - gPlateau,0.01)),gCurve);
+	const float fade = 1.0 - t*t*(3.0-2.0*t);
+	t = saturate(distance / max(gBoundaryRamp,0.5));
+	float weight = fade * t*t*(3.0-2.0*t);
+	const float noise = frac(52.9829189 * frac(dot(float2(pixel),float2(0.06711056,0.00583715))));
+	weight = saturate(weight + (noise-0.5)*gDither*0.02*weight*(1.0-weight));
+	const float2 uv = boundary / float2(gCropSize);
+	const float4 value = gTone.SampleLevel(gLinearClamp,float3(uv,0),0);
+	const float4 slope = gTone.SampleLevel(gLinearClamp,float3(uv,1),0);
+	const float4 curve = gTone.SampleLevel(gLinearClamp,float3(uv,2),0);
+	const float4 source = gDestination[pixel];
+	if (!all(isfinite(source.rgb))) return;
+	const float3 base = max(source.rgb,0.0);
+	const float baseLuma = dot(base,kLuma);
+	const float support = max(0.04,3.0 * sqrt(max(curve.a,0.0)));
+	const float position = clamp(min(baseLuma,1.0) - slope.a,-support,support);
+	const float center = slope.a - 0.25;
+	const float3 meanChange = value.rgb + slope.rgb*center + curve.rgb*(center*center + curve.a);
+	const float3 localSlope = slope.rgb + 2.0*curve.rgb*center;
+	const float contrastFade = gContrastReach >= 1.0 ? 1.0 : 1.0 - smoothstep(gContrastReach,1.0,normalized);
+	const float3 delta = meanChange + contrastFade * (localSlope * (position * gContrast) + curve.rgb * ((position*position - curve.a) * gNonlinear));
+	const float brightness = dot(delta,kLuma);
+	float confidence = saturate(value.a);
+	if (gEdgeProtection > 0.0) {
+		const float3 reference = gTone.SampleLevel(gLinearClamp,float3(uv,3),0).rgb;
+		const float3 difference = reference - base;
+		confidence *= lerp(1.0,1.0 / (1.0 + 32.0 * dot(difference,difference)),gEdgeProtection);
+	}
+	float brightnessChange = brightness * gBrightness;
+	if (brightnessChange > 0.0)
+		brightnessChange *= lerp(1.0,smoothstep(0.001,0.035,baseLuma),gBlackProtection);
+	const float3 change = brightnessChange + (delta - brightness) * gColor;
+	const float3 bound = base * (exp2(gLimitStops)-1.0) + gOffsetLimit;
+	const float3 result = max(source.rgb + clamp(change,-bound,bound) * (weight * confidence),0.0);
+	if (all(isfinite(result))) gDestination[pixel] = float4(result,source.a);
+}
diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamMapCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamMapCS.hlsl
new file mode 100644
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamMapCS.hlsl
@@ -0,0 +1,96 @@
+cbuffer OutsideToneMap : register(b0)
+{
+	uint2 gCropSize;
+	uint2 gCropOrigin;
+	float2 gRadii;
+	float2 gInset;
+	float gLimitStops;
+	float gOffsetLimit;
+	float gSampleWidth;
+	uint gOval;
+	float gSmoothing;
+	uint gMode;
+	float gSampleFocus;
+	float gPadding;
+};
+Texture2D<float4> gOriginal : register(t0);
+Texture2D<float4> gNeural : register(t1);
+RWTexture2DArray<float4> gTone : register(u0);
+static const float3 kLuma = float3(0.2126,0.7152,0.0722);
+
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= uint2(16,16))) return;
+	float2 boundary = (float2(id.xy) + 0.5) * float2(gCropSize) / 16.0;
+	float2 normal;
+	const float2 center = float2(gCropSize) * 0.5;
+	const float2 low = gInset + 0.5, high = float2(gCropSize) - gInset - 0.5;
+	if (gOval != 0u) {
+		float2 offset = boundary - center;
+		offset /= max(length(offset / gRadii),0.00001);
+		boundary = center + offset;
+		normal = normalize(offset / (gRadii * gRadii));
+	} else {
+		boundary = clamp(boundary,low,high);
+		const float4 distances = float4(boundary - low,high - boundary);
+		const float nearest = min(min(distances.x,distances.y),min(distances.z,distances.w));
+		if (nearest == distances.x) { boundary.x = low.x; normal = float2(-1,0); }
+		else if (nearest == distances.y) { boundary.y = low.y; normal = float2(0,-1); }
+		else if (nearest == distances.z) { boundary.x = high.x; normal = float2(1,0); }
+		else { boundary.y = high.y; normal = float2(0,1); }
+	}
+	const float2 tangent = float2(-normal.y,normal.x);
+	float total = 0.0, squareWeight = 0.0;
+	float4 moments = 0.0;
+	float3 base = 0.0, delta = 0.0, delta2 = 0.0, lumaDelta = 0.0, luma2Delta = 0.0;
+	[loop] for (uint y = 0; y < 8; ++y) {
+		[loop] for (uint x = 0; x < 8; ++x) {
+			const float depth = (float(y) + 0.5) / 8.0;
+			const float2 location = boundary - normal * (1.5 + depth * gSampleWidth) + tangent * ((float(x) + 0.5) / 8.0 - 0.5) * gSampleWidth;
+			if (any(location < 0.0) || any(location >= float2(gCropSize))) continue;
+			const uint2 p = uint2(location);
+			const float2 position = float2(p) + 0.5;
+			if (gOval != 0u) {
+				const float2 offset = (position - center) / gRadii;
+				if (dot(offset,offset) > 1.0) continue;
+			} else if (any(position < low) || any(position > high)) continue;
+			float3 b = gOriginal.Load(int3(p,0)).rgb;
+			float3 r = gNeural.Load(int3(p,0)).rgb;
+			if (!all(isfinite(b)) || !all(isfinite(r)) || any(abs(b) > 16.0) || any(abs(r) > 16.0)) continue;
+			b = max(b,0.0); r = max(r,0.0);
+			const float weight = 1.0 / (1.0 + 6.0 * gSampleFocus * depth * depth);
+			const float3 change = r - b;
+			const float value = min(dot(b,kLuma),1.0);
+			const float value2 = value * value;
+			base += b * weight; delta += change * weight; delta2 += change * change * weight;
+			lumaDelta += value * change * weight; luma2Delta += value2 * change * weight;
+			moments += float4(value,value2,value2*value,value2*value2) * weight;
+			total += weight; squareWeight += weight * weight;
+		}
+	}
+	const float inverse = 1.0 / max(total,0.00001);
+	base *= inverse; delta *= inverse; delta2 *= inverse;
+	lumaDelta *= inverse; luma2Delta *= inverse; moments *= inverse;
+	const float mean = moments.x;
+	const float variance = max(moments.y - mean*mean,0.0);
+	const float third = moments.z - 3.0*mean*moments.y + 2.0*mean*mean*mean;
+	const float fourth = max(moments.w - 4.0*mean*moments.z + 6.0*mean*mean*moments.y - 3.0*mean*mean*mean*mean,0.0);
+	const float quadraticVariance = max(fourth - variance*variance,0.0);
+	const float3 covariance = lumaDelta - mean*delta;
+	const float3 quadraticCovariance = luma2Delta - 2.0*mean*lumaDelta + (mean*mean - variance)*delta;
+	const float a = variance + 0.00001, c = quadraticVariance + 0.000001;
+	const float determinant = max(a*c - third*third,0.00000000001);
+	float3 slope = clamp((c*covariance - third*quadraticCovariance) / determinant,-2.0,2.0);
+	float3 curve = clamp((a*quadraticCovariance - third*covariance) / determinant,-4.0,4.0);
+	const float3 error = max(delta2 - delta*delta + slope*slope*variance + curve*curve*quadraticVariance + 2.0*slope*curve*third - 2.0*slope*covariance - 2.0*curve*quadraticCovariance,0.0);
+	const float effectiveSamples = total*total / max(squareWeight,0.00001);
+	const float confidence = saturate(effectiveSamples / 32.0) / (1.0 + dot(error,kLuma) * 100.0);
+	if (total == 0.0) { delta = 0.0; slope = 0.0; curve = 0.0; }
+	const float shift = 0.25 - mean;
+	// A fixed basis preserves the tone curve when neighboring coefficients are interpolated.
+	gTone[uint3(id.xy,0)] = float4(delta + slope*shift + curve*(shift*shift - variance),confidence);
+	gTone[uint3(id.xy,1)] = float4(slope + 2.0*curve*shift,mean);
+	gTone[uint3(id.xy,2)] = float4(curve,variance);
+	gTone[uint3(id.xy,3)] = float4(base,1.0);
+}
diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamSmoothCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamSmoothCS.hlsl
new file mode 100644
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideSeamSmoothCS.hlsl
@@ -0,0 +1,50 @@
+cbuffer OutsideToneMap : register(b0)
+{
+	uint2 gCropSize;
+	uint2 gCropOrigin;
+	float2 gRadii;
+	float2 gInset;
+	float gLimitStops;
+	float gOffsetLimit;
+	float gSampleWidth;
+	uint gOval;
+	float gSmoothing;
+	uint gMode;
+	float gSampleFocus;
+	float gPadding;
+};
+Texture2DArray<float4> gInput : register(t0);
+RWTexture2DArray<float4> gOutput : register(u0);
+
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= uint2(16,16))) return;
+	const int2 p = int2(id.xy);
+	const float4 value = gInput.Load(int4(p,0,0));
+	const float4 slope = gInput.Load(int4(p,1,0));
+	const float4 curve = gInput.Load(int4(p,2,0));
+	const float4 reference = gInput.Load(int4(p,3,0));
+	float3 sumValue = 0.0, sumSlope = 0.0, sumCurve = 0.0;
+	float total = 0.0;
+	[unroll] for (int y = -1; y <= 1; ++y) {
+		[unroll] for (int x = -1; x <= 1; ++x) {
+			const int2 q = clamp(p + int2(x,y),int2(0,0),int2(15,15));
+			const float4 otherValue = gInput.Load(int4(q,0,0));
+			const float4 otherSlope = gInput.Load(int4(q,1,0));
+			const float4 otherCurve = gInput.Load(int4(q,2,0));
+			const float3 difference = gInput.Load(int4(q,3,0)).rgb - reference.rgb;
+			const float spatial = (x == 0 ? 2.0 : 1.0) * (y == 0 ? 2.0 : 1.0);
+			const float weight = spatial * otherValue.a / (1.0 + 64.0 * dot(difference,difference));
+			sumValue += otherValue.rgb * weight;
+			sumSlope += otherSlope.rgb * weight;
+			sumCurve += otherCurve.rgb * weight;
+			total += weight;
+		}
+	}
+	const float amount = total > 0.0 ? gSmoothing : 0.0;
+	gOutput[uint3(id.xy,0)] = float4(lerp(value.rgb,sumValue / max(total,0.00001),amount),value.a);
+	gOutput[uint3(id.xy,1)] = float4(lerp(slope.rgb,sumSlope / max(total,0.00001),amount),slope.a);
+	gOutput[uint3(id.xy,2)] = float4(lerp(curve.rgb,sumCurve / max(total,0.00001),amount),curve.a);
+	gOutput[uint3(id.xy,3)] = reference;
+}
