index 0000000..1eb8bbd
--- /dev/null
+++ b/runtime/open-shaders/src/Features/Upscaling/NeuralRendering/OutsideTonePolicy.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+
+namespace NeuralRendering::OutsideTone
+{
+	struct Config
+	{
+		float brightness = 0.65f, color = 0.30f, width = 128.0f, curve = 1.0f;
+		float dither = 0.15f, boundaryRamp = 8.0f, limitStops = 0.5f, sampleInset = 8.0f;
+	};
+
+	struct Geometry
+	{
+		std::uint32_t x = 0, y = 0, width = 0, height = 0;
+		std::uint32_t eyeX = 0, eyeWidth = 0, eyeHeight = 0;
+		bool oval = false;
+		float maskScale = 1.0f;
+	};
+
+	/** @brief Bounds direct settings writes as well as UI/JSON configuration. */
+	inline Config Sanitize(Config c)
+	{
+		const auto clamp = [](float x, float fallback, float lo, float hi) {
+			return std::clamp(std::isfinite(x) ? x : fallback, lo, hi);
+		};
+		c.brightness = clamp(c.brightness, 0.65f, 0, 1);
+		c.color = clamp(c.color, 0.30f, 0, 1);
+		c.width = clamp(c.width, 128, 8, 512);
+		c.curve = clamp(c.curve, 1, 0.5f, 2);
+		c.dither = clamp(c.dither, 0.15f, 0, 1);
+		c.boundaryRamp = clamp(c.boundaryRamp, 8, 0.5f, 64);
+		c.limitStops = clamp(c.limitStops, 0.5f, 0, 1);
+		c.sampleInset = clamp(c.sampleInset, 8, 0, 25);
+		return c;
+	}
+
+	struct Region
+	{
+		std::uint32_t x = 0, y = 0, width = 0, height = 0;
+	};
+
+	/** @brief Restricts outward writes to one eye and the finite fade envelope. */
+	inline Region MakeRegion(const Geometry& g, float width)
+	{
+		if (!g.width || !g.height || !g.eyeWidth || !g.eyeHeight ||
+			!std::isfinite(g.maskScale) || g.maskScale <= 0 || g.maskScale > 1 ||
+			g.x < g.eyeX || std::uint64_t(g.x) + g.width > std::uint64_t(g.eyeX) + g.eyeWidth ||
+			std::uint64_t(g.y) + g.height > g.eyeHeight || !std::isfinite(width) || width <= 0)
+			return {};
+		const auto pad = static_cast<std::uint32_t>(std::ceil(std::min(width, 512.0f)));
+		const auto left = std::max(g.eyeX, g.x > pad ? g.x - pad : 0u);
+		const auto top = g.y > pad ? g.y - pad : 0u;
+		const auto right = static_cast<std::uint32_t>(std::min(std::uint64_t(g.x) + g.width + pad, std::uint64_t(g.eyeX) + g.eyeWidth));
+		const auto bottom = static_cast<std::uint32_t>(std::min(std::uint64_t(g.y) + g.height + pad, std::uint64_t(g.eyeHeight)));
+		return { left, top, right - left, bottom - top };
+	}
+
+	/** @brief Positive outside distance; mask membership matches the existing compositor. */
+	inline float Distance(float x, float y, const Geometry& g)
+	{
+		const float w = float(g.width), h = float(g.height);
+		if (g.oval) {
+			const float dx = x + 0.5f - w * 0.5f, dy = y + 0.5f - h * 0.5f;
+			const float rx = std::max(0.5f, w * 0.5f * g.maskScale), ry = std::max(0.5f, h * 0.5f * g.maskScale);
+			const float radius = std::sqrt(dx * dx / (rx * rx) + dy * dy / (ry * ry));
+			return radius <= 1.0f ? -1.0f : std::sqrt(dx * dx + dy * dy) * (1.0f - 1.0f / radius);
+		}
+		const float ix = w * (1.0f - g.maskScale) * 0.5f, iy = h * (1.0f - g.maskScale) * 0.5f;
+		const float dx = std::max({ ix - x, x - (w - 1.0f - ix), 0.0f });
+		const float dy = std::max({ iy - y, y - (h - 1.0f - iy), 0.0f });
+		return std::sqrt(dx * dx + dy * dy);
+	}
+
+	/** @brief A continuous outside-only envelope with static dither bounded by the fade. */
+	inline float Weight(float distance, const Config& config, float noise)
+	{
+		if (distance <= 0 || distance >= config.width || config.width <= 0) return 0;
+		const auto smooth = [](float t) { t = std::clamp(t, 0.0f, 1.0f); return t * t * (3.0f - 2.0f * t); };
+		const float fade = 1.0f - smooth(std::pow(distance / config.width, config.curve));
+		const float ramp = smooth(distance / std::max(0.5f, config.boundaryRamp));
+		const float weight = fade * ramp;
+		return std::clamp(weight + (noise - 0.5f) * config.dither * 0.02f * weight * (1.0f - weight), 0.0f, 1.0f);
+	}
+}
