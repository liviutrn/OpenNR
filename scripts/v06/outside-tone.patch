+#include "Utils/LazyShader.h"
+#include <wrl/client.h>
+
+namespace NeuralRendering::OutsideTone
+{
+	using Microsoft::WRL::ComPtr;
+	namespace
+	{
+		struct MapConstants
+		{
+			std::array<std::uint32_t, 2> cropSize{}, sourceOffset{};
+			float limitStops = 0.5f;
+			std::array<float, 3> padding{};
+		};
+		struct ApplyConstants
+		{
+			std::array<std::uint32_t, 2> origin{}, extent{}, cropOrigin{}, cropSize{};
+			std::array<float, 2> radii{}, inset{};
+			float width = 0, brightness = 0, color = 0, curve = 1;
+			float dither = 0, boundaryRamp = 8, sampleInset = 8;
+			std::uint32_t oval = 0;
+			float limitStops = 0.5f;
+			std::array<float, 3> padding{};
+		};
+		static_assert(sizeof(MapConstants) == 32);
+		static_assert(sizeof(ApplyConstants) == 96);
+		Util::LazyShader<ID3D11ComputeShader> mapCS, applyCS;
+		ComPtr<ID3D11Texture2D> tone;
+		ComPtr<ID3D11ShaderResourceView> toneSRV, compositeSRV;
+		ComPtr<ID3D11UnorderedAccessView> toneUAV;
+		ComPtr<ID3D11Resource> cachedComposite;
+		ComPtr<ID3D11Device> cachedDevice;
+		ComPtr<ID3D11Buffer> mapCB, applyCB;
+		ComPtr<ID3D11SamplerState> sampler;
+		Status status;
+		bool failed = false;
+
+		bool Ensure(ID3D11Device* device, ID3D11Resource* composite, ID3D11UnorderedAccessView* destination)
+		{
+			if (cachedDevice.Get() != device) { Reset(); cachedDevice = device; }
+			if (failed) return false;
+			if (!mapCS.Get(L"Data\\Shaders\\Upscaling\\NeuralRendering\\OutsideToneMapCS.hlsl", {}, "cs_5_0", "main", "NeuralRendering::OutsideToneMapCS") ||
+				!applyCS.Get(L"Data\\Shaders\\Upscaling\\NeuralRendering\\OutsideToneApplyCS.hlsl", {}, "cs_5_0", "main", "NeuralRendering::OutsideToneApplyCS")) return false;
+			if (!tone) {
+				D3D11_TEXTURE2D_DESC td{};
+				td.Width = td.Height = 16; td.MipLevels = td.ArraySize = 1;
+				td.Format = DXGI_FORMAT_R32G32B32A32_FLOAT; td.SampleDesc.Count = 1;
+				td.BindFlags = D3D11_BIND_SHADER_RESOURCE | D3D11_BIND_UNORDERED_ACCESS;
+				if (FAILED(device->CreateTexture2D(&td, nullptr, tone.GetAddressOf())) ||
+					FAILED(device->CreateShaderResourceView(tone.Get(), nullptr, toneSRV.GetAddressOf())) ||
+					FAILED(device->CreateUnorderedAccessView(tone.Get(), nullptr, toneUAV.GetAddressOf()))) return false;
+				Util::SetResourceName(tone.Get(), "NeuralRendering::OutsideToneMap");
+				Util::SetResourceName(toneSRV.Get(), "NeuralRendering::OutsideToneMap SRV");
+				Util::SetResourceName(toneUAV.Get(), "NeuralRendering::OutsideToneMap UAV");
+				D3D11_BUFFER_DESC bd{}; bd.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+				bd.ByteWidth = sizeof(MapConstants);
+				if (FAILED(device->CreateBuffer(&bd, nullptr, mapCB.GetAddressOf()))) return false;
+				bd.ByteWidth = sizeof(ApplyConstants);
+				if (FAILED(device->CreateBuffer(&bd, nullptr, applyCB.GetAddressOf()))) return false;
+				Util::SetResourceName(mapCB.Get(), "NeuralRendering::OutsideToneMapCB");
+				Util::SetResourceName(applyCB.Get(), "NeuralRendering::OutsideToneApplyCB");
+				D3D11_SAMPLER_DESC sd{};
+				sd.Filter = D3D11_FILTER_MIN_MAG_MIP_LINEAR;
+				sd.AddressU = sd.AddressV = sd.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+				sd.MaxLOD = D3D11_FLOAT32_MAX;
+				if (FAILED(device->CreateSamplerState(&sd, sampler.GetAddressOf()))) return false;
+				Util::SetResourceName(sampler.Get(), "NeuralRendering::OutsideToneSampler");
+			}
+			if (cachedComposite.Get() != composite) {
+				D3D11_UNORDERED_ACCESS_VIEW_DESC ud{}; destination->GetDesc(&ud);
+				D3D11_FEATURE_DATA_FORMAT_SUPPORT2 support{ ud.Format, 0 };
+				if (FAILED(device->CheckFeatureSupport(D3D11_FEATURE_FORMAT_SUPPORT2, &support, sizeof(support))) ||
+					!(support.OutFormatSupport2 & D3D11_FORMAT_SUPPORT2_UAV_TYPED_LOAD)) return false;
+				D3D11_SHADER_RESOURCE_VIEW_DESC sd{};
+				sd.Format = ud.Format; sd.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D; sd.Texture2D.MipLevels = 1;
+				compositeSRV.Reset();
+				if (FAILED(device->CreateShaderResourceView(composite, &sd, compositeSRV.GetAddressOf()))) return false;
+				Util::SetResourceName(compositeSRV.Get(), "NeuralRendering::OutsideToneComposite SRV");
+				cachedComposite = composite;
+			}
+			return true;
+		}
+	}
+
+	void BeginFrame(std::uint32_t frame, bool enabled)
+	{
+		status = { frame, 0, "No cropped NR output" };
+		if (!enabled) {
+			// Retain the tiny map/shaders for live A/B, but do not pin an old full-frame target.
+			compositeSRV.Reset(); cachedComposite.Reset(); status.message = "Disabled";
+		}
+	}
+	Status GetStatus() { return status; }
+	void Reset()
+	{
+		mapCS.Reset(); applyCS.Reset(); tone.Reset(); toneSRV.Reset(); toneUAV.Reset();
+		compositeSRV.Reset(); cachedComposite.Reset(); cachedDevice.Reset();
+		mapCB.Reset(); applyCB.Reset(); sampler.Reset(); failed = false;
+	}
+
+	bool Apply(ID3D11Device* device, ID3D11DeviceContext* context, ID3D11ShaderResourceView* original,
+		ID3D11Resource* composite, ID3D11UnorderedAccessView* destination, const Geometry& g, const Config& requested)
+	{
+		const auto c = Sanitize(requested);
+		const auto roi = MakeRegion(g, c.width);
+		if (!device || !context || !original || !composite || !destination || !roi.width || !roi.height) {
+			status.message = "Skipped: crop or UAV unavailable"; return false;
+		}
+		if ((c.brightness == 0 && c.color == 0) || c.limitStops == 0) { status.message = "Zero strength/limit: no GPU work"; return true; }
+		if (!Ensure(device, composite, destination)) {
+			failed = true; status.message = "Skipped: unsupported resource or shader; clear shader cache to retry"; return false;
+		}
+		// Save every CS slot this isolated pass touches. Unbind write/read aliases before each transition.
+		ComPtr<ID3D11ComputeShader> savedCS;
+		ComPtr<ID3D11Buffer> savedCB;
+		ComPtr<ID3D11SamplerState> savedSampler;
+		ComPtr<ID3D11UnorderedAccessView> savedUAV;
+		ID3D11ShaderResourceView* savedSRVs[2]{};
+		context->CSGetShader(savedCS.GetAddressOf(), nullptr, nullptr);
+		context->CSGetConstantBuffers(0, 1, savedCB.GetAddressOf());
+		context->CSGetSamplers(0, 1, savedSampler.GetAddressOf());
+		context->CSGetUnorderedAccessViews(0, 1, savedUAV.GetAddressOf());
+		context->CSGetShaderResources(0, 2, savedSRVs);
+		ID3D11UnorderedAccessView* nullUAV = nullptr;
+		ID3D11ShaderResourceView* nullSRVs[2]{};
+		context->CSSetUnorderedAccessViews(0, 1, &nullUAV, nullptr);
+		context->CSSetShaderResources(0, 2, nullSRVs);
+		{
+			CS_GPU_PASS("NeuralRendering::OutsideToneMap");
+			MapConstants mc{ { g.width, g.height }, { g.x, g.y }, c.limitStops, {} };
+			context->UpdateSubresource(mapCB.Get(), 0, nullptr, &mc, 0, 0);
+			context->CSSetShader(mapCS.get(), nullptr, 0);
+			ID3D11Buffer* cb = mapCB.Get(); context->CSSetConstantBuffers(0, 1, &cb);
+			ID3D11ShaderResourceView* sources[]{ original, compositeSRV.Get() };
+			context->CSSetShaderResources(0, 2, sources);
+			ID3D11UnorderedAccessView* uav = toneUAV.Get(); context->CSSetUnorderedAccessViews(0, 1, &uav, nullptr);
+			context->Dispatch(2, 2, 1);
+		}
+		context->CSSetUnorderedAccessViews(0, 1, &nullUAV, nullptr);
+		context->CSSetShaderResources(0, 2, nullSRVs);
+		{
+			CS_GPU_PASS("NeuralRendering::OutsideToneApply");
+			ApplyConstants ac{ { roi.x, roi.y }, { roi.width, roi.height }, { g.x, g.y }, { g.width, g.height },
+				{ std::max(0.5f, float(g.width) * 0.5f * g.maskScale), std::max(0.5f, float(g.height) * 0.5f * g.maskScale) },
+				{ float(g.width) * (1 - g.maskScale) * 0.5f, float(g.height) * (1 - g.maskScale) * 0.5f },
+				c.width, c.brightness, c.color, c.curve, c.dither, c.boundaryRamp, c.sampleInset, g.oval ? 1u : 0u, c.limitStops, {} };
+			context->UpdateSubresource(applyCB.Get(), 0, nullptr, &ac, 0, 0);
+			context->CSSetShader(applyCS.get(), nullptr, 0);
+			ID3D11Buffer* cb = applyCB.Get(); context->CSSetConstantBuffers(0, 1, &cb);
+			ID3D11ShaderResourceView* source = toneSRV.Get(); context->CSSetShaderResources(0, 1, &source);
+			ID3D11SamplerState* smp = sampler.Get(); context->CSSetSamplers(0, 1, &smp);
+			context->CSSetUnorderedAccessViews(0, 1, &destination, nullptr);
+			context->Dispatch((roi.width + 7) / 8, (roi.height + 7) / 8, 1);
+		}
+		context->CSSetUnorderedAccessViews(0, 1, &nullUAV, nullptr);
+		context->CSSetShaderResources(0, 2, nullSRVs);
+		context->CSSetShader(savedCS.Get(), nullptr, 0);
+		ID3D11Buffer* cb = savedCB.Get(); context->CSSetConstantBuffers(0, 1, &cb);
+		ID3D11SamplerState* smp = savedSampler.Get(); context->CSSetSamplers(0, 1, &smp);
+		context->CSSetShaderResources(0, 2, savedSRVs);
+		ID3D11UnorderedAccessView* uav = savedUAV.Get(); context->CSSetUnorderedAccessViews(0, 1, &uav, nullptr);
+		for (auto* srv : savedSRVs) if (srv) srv->Release();
+		++status.eyes; status.message = "Active";
+		return true;
+	}
+}
