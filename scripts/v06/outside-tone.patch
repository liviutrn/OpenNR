new file mode 100644
index 0000000..c033b11
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneApplyCS.hlsl
@@ -0,0 +1,58 @@
+cbuffer OutsideToneApply : register(b0)
+{
+	uint2 gOrigin;
+	uint2 gExtent;
+	uint2 gCropOrigin;
+	uint2 gCropSize;
+	float2 gRadii;
+	float2 gInset;
+	float gWidth;
+	float gBrightness;
+	float gColor;
+	float gCurve;
+	float gDither;
+	float gBoundaryRamp;
+	float gSampleInset;
+	uint gOval;
+	float gLimitStops;
+	float3 gPadding;
+};
+Texture2D<float4> gTone : register(t0);
+RWTexture2D<float4> gDestination : register(u0);
+SamplerState gLinearClamp : register(s0);
+
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= gExtent)) return;
+	const uint2 pixel = id.xy + gOrigin;
+	const float2 local = float2(pixel) - float2(gCropOrigin);
+	float distance;
+	float2 boundary;
+	if (gOval != 0u) {
+		const float2 offset = local + 0.5 - float2(gCropSize) * 0.5;
+		const float radius = length(offset / gRadii);
+		if (radius <= 1.0) return;
+		distance = length(offset) * (1.0 - 1.0 / radius);
+		boundary = offset / radius + float2(gCropSize) * 0.5;
+	} else {
+		const float2 last = float2(gCropSize) - 1.0 - gInset;
+		if (all(local >= gInset) && all(local <= last)) return;
+		const float2 nearest = clamp(local,gInset,last);
+		distance = length(local - nearest);
+		boundary = nearest + 0.5;
+	}
+	if (distance >= gWidth || distance <= 0.0) return;
+	float t = pow(saturate(distance / gWidth),gCurve);
+	const float fade = 1.0 - t*t*(3.0-2.0*t);
+	t = saturate(distance / max(gBoundaryRamp,0.5));
+	float weight = fade * t*t*(3.0-2.0*t);
+	const float noise = frac(52.9829189 * frac(dot(float2(pixel),float2(0.06711056,0.00583715))));
+	weight = saturate(weight + (noise-0.5)*gDither*0.02*weight*(1.0-weight));
+	const float2 uv = lerp(boundary / float2(gCropSize),0.5.xx,gSampleInset * 0.01);
+	const float4 tone = gTone.SampleLevel(gLinearClamp,uv,0);
+	const float3 stops = clamp(tone.w * gBrightness + (tone.rgb - tone.w) * gColor,-gLimitStops,gLimitStops);
+	const float4 source = gDestination[pixel];
+	const float3 result = source.rgb * exp2(stops * weight);
+	if (all(isfinite(result))) gDestination[pixel] = float4(result,source.a);
+}
diff --git a/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneMapCS.hlsl b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneMapCS.hlsl
new file mode 100644
index 0000000..c2a021c
--- /dev/null
+++ b/runtime/open-shaders/features/Upscaling/Shaders/Upscaling/NeuralRendering/OutsideToneMapCS.hlsl
@@ -0,0 +1,33 @@
+cbuffer OutsideToneMap : register(b0)
+{
+	uint2 gCropSize;
+	uint2 gSourceOffset;
+	float gLimitStops;
+	float3 gPadding;
+};
+Texture2D<float4> gOriginal : register(t0);
+Texture2D<float4> gComposite : register(t1);
+RWTexture2D<float4> gTone : register(u0);
+
+[numthreads(8,8,1)]
+void main(uint3 id : SV_DispatchThreadID)
+{
+	if (any(id.xy >= uint2(16,16))) return;
+	float3 base = 0.0, result = 0.0;
+	[loop] for (uint y = 0; y < 8; ++y) {
+		[loop] for (uint x = 0; x < 8; ++x) {
+			const uint2 p = min(uint2((float2(id.xy) + (float2(x,y) + 0.5) / 8.0) * float2(gCropSize) / 16.0), gCropSize - 1u);
+			float3 b = gOriginal.Load(int3(p,0)).rgb;
+			const float3 r = gComposite.Load(int3(p + gSourceOffset,0)).rgb;
+			b = all(isfinite(b)) ? max(b,0.0) : 0.0;
+			base += b;
+			result += all(isfinite(r)) ? max(r,0.0) : max(b,0.0);
+		}
+	}
+	base /= 64.0; result /= 64.0;
+	const float3 luma = float3(0.2126,0.7152,0.0722);
+	const float brightness = clamp(log2((dot(result,luma) + 0.01) / (dot(base,luma) + 0.01)), -gLimitStops, gLimitStops);
+	const float3 rgb = clamp(log2((result + 0.01) / (base + 0.01)), -gLimitStops, gLimitStops);
+	const float confidence = smoothstep(0.002,0.03,dot(base,luma));
+	gTone[id.xy] = float4(rgb,brightness) * confidence;
+}
