@@ -0,0 +1,25 @@
+#pragma once
+#include <cstdint>
+#include "../FoveatedCommon.h"
+
+namespace ShaderDetailMask
+{
+	inline constexpr float kRectangleGuard = 1.189208f;
+
+	/** @brief Encloses both SR rectangles in a power-four mask without reducing their corners. */
+	template<class Profile, class Region>
+	bool ProtectRectangles(Profile& profile, const Region& left, const Region& right)
+	{
+		const float height = std::max(left.h, right.h);
+		const float width = std::max(left.w, right.w);
+		const float scale = FoveatedCommon::ClampCenterScale(std::max(height, width * 0.5f) * kRectangleGuard);
+		if (!FoveatedCommon::IsActiveCoverage(scale))
+			return false;
+		profile.available = true;
+		profile.coverageScale = scale;
+		profile.centerHorizontalScale = FoveatedCommon::ClampCenterHorizontalScale(width * kRectangleGuard / scale);
+		profile.centerOffsets[0] = { left.x + left.w * 0.5f - 0.5f, left.y + left.h * 0.5f - 0.5f };
+		profile.centerOffsets[1] = { right.x + right.w * 0.5f - 0.5f, right.y + right.h * 0.5f - 0.5f };
+		return true;
+	}
+}
