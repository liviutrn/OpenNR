@@ -65,4 +65,84 @@ private:
     std::array<std::optional<Record>, Capacity> m_slots{};
 };
 
+// Bounded source-family storage keyed by both engine frame and family owner.
+// Auxiliary families sharing a frame can never replace the selected main
+// family. Entries older than the retained frame window are the only evictions.
+template <class Payload, size_t Capacity = 128>
+class OwnerFrameRing {
+    static_assert(Capacity > 1);
+
+public:
+    template <class Fn>
+    bool mutate(uint32_t frame, uintptr_t owner, Fn&& fn) {
+        if (owner == 0) { return false; }
+        std::scoped_lock lock{m_mutex};
+        Slot* exact{};
+        Slot* empty{};
+        Slot* stale{};
+        uint32_t stale_age{};
+        for (auto& slot : m_slots) {
+            if (slot.owner == owner && slot.frame == frame) {
+                exact = &slot;
+                break;
+            }
+            if (slot.owner == 0 && empty == nullptr) { empty = &slot; }
+            if (slot.owner != 0) {
+                const auto age = static_cast<uint32_t>(frame - slot.frame);
+                if (age >= retained_frame_window && age < 0x80000000u && age > stale_age) {
+                    stale = &slot;
+                    stale_age = age;
+                }
+            }
+        }
+        auto* slot = exact != nullptr ? exact : empty != nullptr ? empty : stale;
+        if (slot == nullptr) { return false; }
+        const bool inserted = slot != exact;
+        if (inserted) {
+            slot->frame = frame;
+            slot->owner = owner;
+            slot->payload = Payload{};
+        }
+        std::forward<Fn>(fn)(slot->payload, inserted);
+        return true;
+    }
+
+    template <class Fn>
+    bool mutate_if_present(uint32_t frame, uintptr_t owner, Fn&& fn) {
+        if (owner == 0) { return false; }
+        std::scoped_lock lock{m_mutex};
+        for (auto& slot : m_slots) {
+            if (slot.owner == owner && slot.frame == frame) {
+                std::forward<Fn>(fn)(slot.payload);
+                return true;
+            }
+        }
+        return false;
+    }
+
+    std::optional<Payload> read(uint32_t frame, uintptr_t owner) const {
+        if (owner == 0) { return std::nullopt; }
+        std::scoped_lock lock{m_mutex};
+        for (const auto& slot : m_slots) {
+            if (slot.owner == owner && slot.frame == frame) { return slot.payload; }
+        }
+        return std::nullopt;
+    }
+
+    void clear() {
+        std::scoped_lock lock{m_mutex};
+        for (auto& slot : m_slots) { slot = {}; }
+    }
+
+private:
+    static constexpr uint32_t retained_frame_window = 16;
+    struct Slot {
+        uint32_t frame{};
+        uintptr_t owner{};
+        Payload payload{};
+    };
+    mutable std::mutex m_mutex{};
+    std::array<Slot, Capacity> m_slots{};
+};
+
 } // namespace uevr::duoview
