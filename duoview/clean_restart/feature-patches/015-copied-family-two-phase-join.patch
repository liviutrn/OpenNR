+void FFakeStereoRenderingHook::mark_native_duoview_main_family(
+    sdk::FSceneViewFamily& family, uint32_t source_frame)
+{
+    auto* const target_manager = get_render_target_manager();
+    auto* const expected_target = target_manager != nullptr
+        ? target_manager->get_view_family_render_target()
+        : nullptr;
+    auto* const views = family.get_views();
+    if (expected_target == nullptr || family.get_render_target() != expected_target ||
+        views == nullptr || views->count != 2 || views->capacity < 2 || views->data == nullptr ||
+        !is_readable_process_range(reinterpret_cast<uintptr_t>(views->data), sizeof(void*) * 2) ||
+        !sdk::FSceneViewFamily::validate_views(&family, views, 2)) {
+        return;
+    }
+
+    bool ambiguous{};
+    const auto source = m_native_duoview_source_families.mutate_unique(
+        [&](uint32_t frame, uintptr_t, const NativeDuoViewSourceFamily& candidate) {
+            return frame == source_frame && candidate.source_frame == source_frame && candidate.selected &&
+                candidate.view_mask == 0x3 && !candidate.conflicted &&
+                candidate.scene == family.get_scene_interface() && candidate.target == expected_target &&
+                candidate.views[0] != nullptr && candidate.views[1] != nullptr &&
+                candidate.views[0] != candidate.views[1] &&
+                ((views->data[0] == candidate.views[0] && views->data[1] == candidate.views[1]) ||
+                    (views->data[0] == candidate.views[1] && views->data[1] == candidate.views[0]));
+        },
+        [](NativeDuoViewSourceFamily& candidate) { candidate.main_family_validated = true; },
+        ambiguous);
+
+    if (!source.has_value()) {
+        SPDLOG_INFO_EVERY_N_SEC(2,
+            "[DuoView] Main-family source did not validate uniquely for frame={} scene={:x} target={:x} ambiguous={}",
+            source_frame, reinterpret_cast<uintptr_t>(family.get_scene_interface()),
+            reinterpret_cast<uintptr_t>(family.get_render_target()), ambiguous);
+        return;
+    }
+    try_publish_native_duoview_transaction(source->frame, source->owner);
+}
