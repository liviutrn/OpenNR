 namespace uevr::duoview {
 
+// Joins the game-thread Native Fix packet to the exact RHI frame token. The
+// callbacks may arrive in either order; callers publish only when take_ready
+// returns a token, and repeated Presents/callbacks cannot complete it twice.
+class NativeFrameJoin {
+public:
+    struct Token {
+        uint32_t submit_frame{};
+        uint64_t output_generation{};
+    };
+
+    void mark_packet_available() { m_packet_available = true; }
+
+    bool bind_rhi_token(uint32_t submit_frame, uint64_t output_generation) {
+        if (output_generation == 0) { return false; }
+        if (!m_rhi_available || m_token.submit_frame != submit_frame ||
+            m_token.output_generation != output_generation) {
+            m_token = Token{submit_frame, output_generation};
+            m_rhi_available = true;
+            m_published = false;
+        }
+        return true;
+    }
+
+    std::optional<Token> take_ready(bool packet_required) {
+        if (!m_rhi_available || (packet_required && !m_packet_available) || m_published) {
+            return std::nullopt;
+        }
+        m_published = true;
+        return m_token;
+    }
+
+private:
+    Token m_token{};
+    bool m_packet_available{};
+    bool m_rhi_available{};
+    bool m_published{};
+};
