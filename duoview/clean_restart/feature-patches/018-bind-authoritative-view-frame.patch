--- a/src/mods/vr/DuoViewFrameTransactions.hpp
+++ b/src/mods/vr/DuoViewFrameTransactions.hpp
@@ -9,6 +9,49 @@
 
 namespace uevr::duoview {
 
+struct SourceFamilyIdentity {
+    uint32_t source_frame{};
+    uintptr_t scene{};
+    uintptr_t target{};
+    uintptr_t views[2]{};
+    uint8_t view_mask{};
+    bool selected{};
+    bool source_frame_valid{};
+    bool main_family_validated{};
+    bool conflicted{};
+};
+
+struct MainFamilyIdentity {
+    uint32_t frame{};
+    uintptr_t scene{};
+    uintptr_t target{};
+    uintptr_t views[2]{};
+};
+
+inline bool matches_authoritative_main_family(
+    const SourceFamilyIdentity& source, const MainFamilyIdentity& family)
+{
+    return source.selected && source.view_mask == 0x3 && !source.conflicted &&
+        source.scene != 0 && source.scene == family.scene &&
+        source.target != 0 && source.target == family.target &&
+        source.views[0] != 0 && source.views[1] != 0 && source.views[0] != source.views[1] &&
+        ((source.views[0] == family.views[0] && source.views[1] == family.views[1]) ||
+         (source.views[0] == family.views[1] && source.views[1] == family.views[0])) &&
+        (!source.source_frame_valid || source.source_frame == family.frame);
+}
+
+inline bool bind_authoritative_source_frame(
+    SourceFamilyIdentity& source, const MainFamilyIdentity& family)
+{
+    if (!matches_authoritative_main_family(source, family)) {
+        return false;
+    }
+    source.source_frame = family.frame;
+    source.source_frame_valid = true;
+    source.main_family_validated = true;
+    return true;
+}
+
 // Joins the game-thread Native Fix packet to the exact RHI frame token. The
 // callbacks may arrive in either order; callers publish only when take_ready
 // returns a token, and repeated Presents/callbacks cannot complete it twice.
@@ -213,6 +256,16 @@ public:
         return Match{selected->frame, selected->owner, selected->payload};
     }
 
+    template <class Fn>
+    void visit(Fn&& fn) const {
+        std::scoped_lock lock{m_mutex};
+        for (const auto& slot : m_slots) {
+            if (slot.owner != 0) {
+                fn(slot.frame, slot.owner, slot.payload);
+            }
+        }
+    }
+
     void clear() {
         std::scoped_lock lock{m_mutex};
         for (auto& slot : m_slots) { slot = {}; }
