+std::optional<std::array<FIntRect, 2>> FFakeStereoRenderingHook::get_native_duoview_view_rects(
+    uint32_t engine_frame) const
+{
+    std::scoped_lock lock{m_sceneview_data.mtx};
+    if (m_sceneview_data.native_stereo_metadata_frame != engine_frame) {
+        return std::nullopt;
+    }
+
+    const auto rect_is_sane = [](const FIntRect& rect) {
+        const auto width = static_cast<int64_t>(rect.bounds[2]) - rect.bounds[0];
+        const auto height = static_cast<int64_t>(rect.bounds[3]) - rect.bounds[1];
+        return width > 0 && height > 0 && width <= 32768 && height <= 32768 &&
+            rect.bounds[0] >= 0 && rect.bounds[1] >= 0;
+    };
+
+    std::optional<std::array<FIntRect, 2>> result{};
+    const auto& views = m_sceneview_data.native_stereo_views;
+    for (const auto& [primary_view, primary] : views) {
+        if (primary_view == nullptr || primary.frame != engine_frame ||
+            primary.original_stereo_pass != EStereoscopicPass::eSSP_PRIMARY ||
+            primary.family == nullptr || !primary.projection_valid || !rect_is_sane(primary.view_rect)) {
+            continue;
+        }
+
+        for (const auto& [secondary_view, secondary] : views) {
+            if (secondary_view == nullptr || secondary_view == primary_view ||
+                secondary.frame != engine_frame ||
+                secondary.original_stereo_pass != EStereoscopicPass::eSSP_SECONDARY ||
+                secondary.family != primary.family || secondary.scene != primary.scene ||
+                secondary.player_index_valid != primary.player_index_valid ||
+                (primary.player_index_valid && secondary.player_index != primary.player_index) ||
+                !secondary.projection_valid || !rect_is_sane(secondary.view_rect)) {
+                continue;
+            }
+
+            if (result.has_value()) {
+                return std::nullopt;
+            }
+            result = std::array<FIntRect, 2>{primary.view_rect, secondary.view_rect};
+        }
+    }
+    return result;
+}
