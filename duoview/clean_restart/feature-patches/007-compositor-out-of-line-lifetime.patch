 bool D3D12Compositor::ensure_pipeline(ID3D12Device* device) {
     if (device == nullptr) { return false; }
     if (m_device.Get() == device && m_root_signature != nullptr && m_unorm_pipeline != nullptr && m_srgb_pipeline != nullptr) {
