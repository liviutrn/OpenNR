+void FFakeStereoRenderingHook::record_native_duoview_source_view(
+    const NativeDuoViewSourceFamily& source, uint32_t eye)
+{
+    if (eye > 1 || source.family == nullptr || source.views[eye] == nullptr) {
+        return;
+    }
+
+    std::scoped_lock lock{m_native_duoview_source_mtx};
+    auto& slot = m_native_duoview_source_families[source.source_frame % m_native_duoview_source_families.size()];
+    if (slot.family != source.family || slot.source_frame != source.source_frame) {
+        slot = source;
+        slot.views[0] = nullptr;
+        slot.views[1] = nullptr;
+        slot.view_mask = 0;
+        slot.conflicted = false;
+    } else {
+        const auto same_parameters = [](const uevr::duoview::Parameters& a, const uevr::duoview::Parameters& b) {
+            return a.fovea_width == b.fovea_width && a.fovea_height == b.fovea_height &&
+                a.fovea_scale == b.fovea_scale && a.periphery_scale == b.periphery_scale &&
+                a.vertical_center == b.vertical_center && a.feather_pixels == b.feather_pixels &&
+                a.optical_center_x == b.optical_center_x && a.optical_center_y == b.optical_center_y;
+        };
+        if (slot.settings_frame != source.settings_frame || slot.scene != source.scene ||
+            slot.target != source.target || slot.selected != source.selected ||
+            slot.native_stereo_fix != source.native_stereo_fix ||
+            !same_parameters(slot.parameters, source.parameters)) {
+            slot.conflicted = true;
+        }
+    }
+
+    const auto bit = static_cast<uint8_t>(1u << eye);
+    if ((slot.view_mask & bit) != 0) {
+        const auto& previous = slot.rects[eye];
+        const auto& next = source.rects[eye];
+        if (slot.views[eye] != source.views[eye] || previous.bounds[0] != next.bounds[0] ||
+            previous.bounds[1] != next.bounds[1] || previous.bounds[2] != next.bounds[2] ||
+            previous.bounds[3] != next.bounds[3] ||
+            slot.projection_valid[eye] != source.projection_valid[eye]) {
+            slot.conflicted = true;
+        }
+    }
+    slot.views[eye] = source.views[eye];
+    slot.rects[eye] = source.rects[eye];
+    slot.projection_valid[eye] = source.projection_valid[eye];
+    slot.view_mask |= bit;
+}
