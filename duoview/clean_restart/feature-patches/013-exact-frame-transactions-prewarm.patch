+std::optional<FFakeStereoRenderingHook::NativeDuoViewSourceFamily>
+FFakeStereoRenderingHook::get_native_duoview_source_family(
+    sdk::FSceneViewFamily* family, uint32_t source_frame) const
+{
+    if (family == nullptr) { return std::nullopt; }
+    std::scoped_lock lock{m_native_duoview_source_mtx};
+    const auto& source = m_native_duoview_source_families[source_frame % m_native_duoview_source_families.size()];
+    if (source.family != family || source.source_frame != source_frame || source.view_mask != 0x3 ||
+        source.views[0] == nullptr || source.views[1] == nullptr || source.views[0] == source.views[1] ||
+        source.scene == nullptr || source.target == nullptr || source.conflicted ||
+        !source.projection_valid[0] || !source.projection_valid[1]) {
+        return std::nullopt;
+    }
+    return source;
+}
