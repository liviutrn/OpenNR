+static void test_duoview_frame_transactions() {
+    namespace duo = uevr::duoview;
+    struct Source {
+        uint32_t family_frame{};
+        uintptr_t family{};
+        uintptr_t resource{};
+    };
+    duo::FrameTransactionRing<Source, 8> transactions;
+
+    expect(transactions.publish(100, 4, 1, {100, 0xabc, 0xdef}), "source frame 100 publishes");
+    expect(transactions.publish(101, 4, 2, {101, 0xabd, 0xdef}), "producer can run one frame ahead");
+    expect(transactions.publish(102, 4, 3, {102, 0xabe, 0xdef}), "producer can run two frames ahead");
+    const auto first_present = transactions.read(100, 4);
+    expect(first_present && first_present->payload.family_frame == 100 && first_present->payload.family == 0xabc,
+        "exact Present token selects its own family while newer producer slots exist");
+    const auto duplicate_present = transactions.read(100, 4);
+    expect(duplicate_present && duplicate_present->serial == first_present->serial,
+        "duplicate Present reuses the same source transaction");
+    const auto second_present = transactions.read(101, 4);
+    expect(second_present && second_present->payload.family_frame == 101,
+        "post-present counter advancement does not change the exact source token");
+    expect(!transactions.read(103, 4), "missing source token does not fall back to the newest frame");
+
+    expect(transactions.publish(103, 4, 4, {103, 0xabf, 0xdef}),
+        "same source resource can publish under a distinct frame token");
+    const auto same_resource_first = transactions.read(102, 4);
+    const auto same_resource_second = transactions.read(103, 4);
+    expect(same_resource_first && same_resource_second &&
+        same_resource_first->payload.resource == same_resource_second->payload.resource &&
+        same_resource_first->payload.family_frame != same_resource_second->payload.family_frame,
+        "resource identity reuse does not collapse distinct source-frame ownership");
+
+    expect(transactions.reject(100, 4, 1), "transient failure marks only its exact frame slot");
+    const auto rejected = transactions.read(100, 4);
+    const auto next_valid = transactions.read(101, 4);
+    expect(rejected && rejected->rejected && next_valid && !next_valid->rejected && next_valid->generation == 4,
+        "a transient frame rejection does not poison the capture generation or later frames");
+
+    transactions.clear();
+    expect(!transactions.read(101, 4), "output-generation reset clears old source ownership");
+    expect(transactions.publish(101, 5, 5, {101, 0xacd, 0xdef}) && transactions.read(101, 5),
+        "new output generation accepts only a newly published source transaction");
+}
