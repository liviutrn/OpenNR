+// fall through to a newer token, and repeated Presents can read the same slot.
+template <class Payload, size_t Capacity = 16>
+class FrameTransactionRing {
+    static_assert(Capacity > 1);
+
+public:
+    struct Record {
+        uint32_t frame{};
+        uint64_t generation{};
+        uint64_t serial{};
+        bool rejected{};
+        Payload payload{};
+    };
+
+    bool publish(uint32_t frame, uint64_t generation, uint64_t serial, Payload payload) {
+        std::scoped_lock lock{m_mutex};
+        m_slots[frame % Capacity] = Record{
+            .frame = frame,
+            .generation = generation,
+            .serial = serial,
+            .rejected = false,
+            .payload = std::move(payload),
+        };
+        return true;
+    }
+
+    std::optional<Record> read(uint32_t frame, uint64_t generation) const {
+        std::scoped_lock lock{m_mutex};
+        const auto& slot = m_slots[frame % Capacity];
+        if (!slot || slot->frame != frame || slot->generation != generation) {
+            return std::nullopt;
+        }
+        return slot;
+    }
+
+    bool reject(uint32_t frame, uint64_t generation, uint64_t serial) {
+        std::scoped_lock lock{m_mutex};
+        auto& slot = m_slots[frame % Capacity];
+        if (!slot || slot->frame != frame || slot->generation != generation || slot->serial != serial) {
+            return false;
+        }
+        slot->rejected = true;
+        return true;
+    }
+
+    void clear() {
+        std::scoped_lock lock{m_mutex};
+        for (auto& slot : m_slots) { slot.reset(); }
+    }
+
+private:
+    mutable std::mutex m_mutex{};
+    std::array<std::optional<Record>, Capacity> m_slots{};
+};
+
