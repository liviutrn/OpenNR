+void FFakeStereoRenderingHook::publish_native_duoview_transaction(
+    NativeDuoViewTransaction transaction, uint64_t output_generation)
+{
+    if (transaction.family == 0 || output_generation == 0 || !transaction.selected) {
+        return;
+    }
+
+    transaction.serial = m_native_duoview_transaction_serial.fetch_add(1, std::memory_order_acq_rel) + 1;
+    const auto previous = m_native_duoview_transactions.read(transaction.submit_frame, output_generation);
+    if (previous.has_value()) {
+        if (previous->payload.family != transaction.family || previous->payload.source_frame != transaction.source_frame) {
+            SPDLOG_WARNING_EVERY_N_SEC(2,
+                "[DuoView] Refusing ambiguous source families for exact submit token frame={} generation={} first_family={:x} second_family={:x}",
+                transaction.submit_frame, output_generation, previous->payload.family, transaction.family);
+        }
+        return;
+    }
+
+    m_native_duoview_transactions.publish(
+        transaction.submit_frame, output_generation, transaction.serial, std::move(transaction));
+}
+
+std::optional<FFakeStereoRenderingHook::NativeDuoViewTransactionRecord>
+FFakeStereoRenderingHook::get_native_duoview_transaction(
+    uint32_t submit_frame, uint64_t output_generation) const
+{
+    return m_native_duoview_transactions.read(submit_frame, output_generation);
+}
+
+bool FFakeStereoRenderingHook::reject_native_duoview_transaction(
+    uint32_t submit_frame, uint64_t output_generation, uint64_t serial, const char* detail)
+{
+    if (!m_native_duoview_transactions.reject(submit_frame, output_generation, serial)) {
+        return false;
+    }
+    SPDLOG_WARNING_EVERY_N_SEC(2,
+        "[DuoView] Rejected only submit frame={} generation={} serial={} reason={}",
+        submit_frame, output_generation, serial, detail != nullptr ? detail : "unspecified frame failure");
+    return true;
+}
