+    const bool native_duoview_source_selected = vr->is_native_duoview_selected_for_frame(g_frame_count);
+    const bool native_duoview_packet = native_stereo_packet != nullptr && native_stereo_packet->duoview;
+    const bool native_duoview_frame = native_duoview_source_selected || native_duoview_packet;
     bool duoview_scene_valid = !native_duoview_frame;
     auto* const native_stereo_hook = ffsr.get();
     const auto record_native_submit = [&](frame_diag::Runtime api, frame_diag::Stage stage,
@@ -3691,7 +3696,12 @@ vr::EVRCompositorError D3D12Component::on_frame(VR* vr) {
     uevr::duoview::SourceRect duoview_fovea_rect{};
