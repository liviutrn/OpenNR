+        native_stereo_packet->right_pass == static_cast<uint32_t>(EStereoscopicPass::eSSP_SECONDARY);
+    if (native_duoview_frame && native_duoview_packet_pair_valid && scene_capture_packet_ready &&
         native_stereo_packet->duoview_projections_valid && m_game_tex.texture != nullptr &&
         m_scene_capture_tex.texture != nullptr)
     {
@@ -3793,15 +3803,7 @@ vr::EVRCompositorError D3D12Component::on_frame(VR* vr) {
             .back = 1
         };
 
-        if (stalker_exact) {
-            if (!commands.ready()) { return; }
-            ComPtr<ID3D12Device> device;
-            if (FAILED(render_target->GetDevice(IID_PPV_ARGS(&device)))) { return; }
-            stalker_composed = uevr::stalker2_native::record_pair(commands.cmd_list.Get(), device.Get(),
