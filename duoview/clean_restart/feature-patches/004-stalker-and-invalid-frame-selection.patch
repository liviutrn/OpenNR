             if (FAILED(render_target->GetDevice(IID_PPV_ARGS(&output_device)))) { return; }
@@ -3810,6 +3812,15 @@ vr::EVRCompositorError D3D12Component::on_frame(VR* vr) {
                 duoview_fovea_rect, duoview_periphery_rect, duoview_geometry,
