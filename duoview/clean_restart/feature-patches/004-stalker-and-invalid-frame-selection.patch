                     draw_status_badge("DuoView status:", "unsupported: NASCAR keeps its validated Native Fix path", blocked_color);
-                } else if (should_force_native_stereo_fix_same_pass()) {
-                    draw_status_badge("DuoView status:", "unsupported: preserved Stalker 2 same-pass policy", blocked_color);
                 } else if (is_native_duoview_active()) {
                     draw_status_badge("DuoView status:", "active with Native Stereo Fix", active_color);
                 } else {
diff --git a/src/mods/VR.hpp b/src/mods/VR.hpp
index b9f0a8fe..6d19bb5e 100644
--- a/src/mods/VR.hpp
+++ b/src/mods/VR.hpp
@@ -704,22 +704,18 @@ public:
 
     bool is_native_duoview_active() const {
         return m_is_d3d12 && is_native_stereo_fix_enabled() && !uevr::nascar::is_target() &&
-            !should_force_native_stereo_fix_same_pass() && !is_using_2d_screen();
+            !is_using_2d_screen();
+    }
+
+    bool is_native_duoview_selected_for_frame(uint32_t engine_frame) {
+        std::scoped_lock lock{m_native_duoview_snapshot_mtx};
+        update_native_duoview_snapshot_locked(engine_frame);
+        return m_native_duoview_snapshot_active;
     }
 
     uevr::duoview::Parameters native_duoview_parameters_for_frame(uint32_t engine_frame) {
         std::scoped_lock lock{m_native_duoview_snapshot_mtx};
-        if (m_native_duoview_snapshot_frame != engine_frame) {
-            m_native_duoview_snapshot = {
-                m_duoview_fovea_width->value() / 100.0f,
-                m_duoview_fovea_height->value() / 100.0f,
-                m_duoview_fovea_scale->value() / 100.0f,
-                m_duoview_periphery_scale->value() / 100.0f,
-                m_duoview_vertical_center->value() / 100.0f,
-                m_duoview_feather_pixels->value(),
-            };
-            m_native_duoview_snapshot_frame = engine_frame;
-        }
+        update_native_duoview_snapshot_locked(engine_frame);
         return m_native_duoview_snapshot;
     }
 
@@ -1935,6 +1931,7 @@ private:
     std::mutex m_native_duoview_snapshot_mtx{};
     uint32_t m_native_duoview_snapshot_frame{std::numeric_limits<uint32_t>::max()};
     uevr::duoview::Parameters m_native_duoview_snapshot{};
+    bool m_native_duoview_snapshot_active{};
     const ModToggle::Ptr m_native_stereo_fix_same_pass{ ModToggle::create(generate_name("NativeStereoFixSamePass"), true) };
     const ModToggle::Ptr m_native_stereo_fix_preserve_secondary_pass{ ModToggle::create(generate_name("NativeStereoFixPreserveSecondaryPass"), true) };
     const ModToggle::Ptr m_native_stereo_fix_texture_array_submit{ ModToggle::create(generate_name("NativeStereoFixTextureArraySubmit"), false) };
@@ -2477,6 +2474,23 @@ public:
     }
 
 private:
+    void update_native_duoview_snapshot_locked(uint32_t engine_frame) {
+        if (m_native_duoview_snapshot_frame == engine_frame) { return; }
+
+        // Publish one immutable parameter set for the entire native frame.
+        // The view hooks and the compositor consume this same snapshot.
+        m_native_duoview_snapshot_active = is_native_duoview_active();
+        m_native_duoview_snapshot = {
+            .fovea_width = m_duoview_fovea_width->value() / 100.0f,
+            .fovea_height = m_duoview_fovea_height->value() / 100.0f,
+            .fovea_scale = m_duoview_fovea_scale->value() / 100.0f,
+            .periphery_scale = m_duoview_periphery_scale->value() / 100.0f,
+            .vertical_center = m_duoview_vertical_center->value() / 100.0f,
+            .feather_pixels = m_duoview_feather_pixels->value(),
+        };
+        m_native_duoview_snapshot_frame = engine_frame;
+    }
+
     bool m_stereo_emulation_mode{false}; // not a good config option, just for debugging
     bool m_wait_for_present{true};
     const ModToggle::Ptr m_controllers_allowed{ ModToggle::create(generate_name("ControllersAllowed"), true) };
