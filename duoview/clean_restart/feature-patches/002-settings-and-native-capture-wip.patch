From 93a44a7c26d9ab9eb8045c832c99e0e6ae74637f Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 18 Oct 2026 00:02:28 +0200
Subject: [PATCH] Wire DuoView settings into native frame capture

---
 src/mods/VR.cpp                          | 21 ++++++++++
 src/mods/VR.hpp                          | 38 ++++++++++++++++++
 src/mods/vr/DuoViewGeometry.hpp          |  2 +
 src/mods/vr/FFakeStereoRenderingHook.cpp | 50 ++++++++++++++++++++++--
 src/mods/vr/FFakeStereoRenderingHook.hpp |  6 +++
 5 files changed, 113 insertions(+), 4 deletions(-)

diff --git a/src/mods/VR.cpp b/src/mods/VR.cpp
index a4ff6a90..6edf3b13 100644
--- a/src/mods/VR.cpp
+++ b/src/mods/VR.cpp
@@ -15450,6 +15450,27 @@ void VR::on_draw_sidebar_entry(std::string_view name) {
         ImGui::SetNextItemOpen(true, ImGuiCond_::ImGuiCond_Once);
         if (ImGui::TreeNode("Native Stereo Fix")) {
             m_native_stereo_fix->draw("Enabled");
+            if (ImGui::TreeNode("Fixed-center DuoView (ID 0)")) {
+                m_duoview_fovea_width->draw("Fovea width (%)");
+                m_duoview_fovea_height->draw("Fovea height (%)");
+                m_duoview_fovea_scale->draw("Fovea resolution scale (%)");
+                m_duoview_periphery_scale->draw("Periphery resolution scale (%)");
+                m_duoview_vertical_center->draw("Fovea vertical center (%)");
+                m_duoview_feather_pixels->draw("Edge blend width (output px)");
+                ImGui::TextWrapped("ID 0 is the fixed-center mono DuoView build: Native Fix left source is the high-resolution fovea, right capture is the low-resolution full-field periphery, and one composite is sent to both eyes.");
+                if (!m_is_d3d12) {
+                    draw_status_badge("DuoView status:", "unsupported: D3D12 required", blocked_color);
+                } else if (uevr::nascar::is_target()) {
+                    draw_status_badge("DuoView status:", "unsupported: NASCAR keeps its validated Native Fix path", blocked_color);
+                } else if (should_force_native_stereo_fix_same_pass()) {
+                    draw_status_badge("DuoView status:", "unsupported: preserved Stalker 2 same-pass policy", blocked_color);
+                } else if (is_native_duoview_active()) {
+                    draw_status_badge("DuoView status:", "active with Native Stereo Fix", active_color);
+                } else {
+                    draw_status_badge("DuoView status:", "waiting: enable Native Stereo Fix in ID 0", skipped_color);
+                }
+                ImGui::TreePop();
+            }
             if (!m_native_stereo_fix->value()) {
                 draw_status_badge("Native Fix status:", "skipped: disabled", skipped_color);
             } else if (m_rendering_method->value() != RenderingMethod::NATIVE_STEREO) {
diff --git a/src/mods/VR.hpp b/src/mods/VR.hpp
index 6bb961a9..b9f0a8fe 100644
--- a/src/mods/VR.hpp
+++ b/src/mods/VR.hpp
@@ -11,6 +11,7 @@
 #include <condition_variable>
 #include <deque>
 #include <filesystem>
+#include <limits>
 #include <mutex>
 #include <optional>
 #include <stop_token>
@@ -41,6 +42,7 @@
 #include "vr/ProSpiCelebrationFraming.hpp"
 #include "vr/ProSpiCameraCutGuard.hpp"
 #include "vr/ProSpiRoofVisibility.hpp"
+#include "vr/DuoViewGeometry.hpp"
 
 #undef max
 #include <tracy/Tracy.hpp>
@@ -700,6 +702,27 @@ public:
             !is_using_afr();
     }
 
+    bool is_native_duoview_active() const {
+        return m_is_d3d12 && is_native_stereo_fix_enabled() && !uevr::nascar::is_target() &&
+            !should_force_native_stereo_fix_same_pass() && !is_using_2d_screen();
+    }
+
+    uevr::duoview::Parameters native_duoview_parameters_for_frame(uint32_t engine_frame) {
+        std::scoped_lock lock{m_native_duoview_snapshot_mtx};
+        if (m_native_duoview_snapshot_frame != engine_frame) {
+            m_native_duoview_snapshot = {
+                m_duoview_fovea_width->value() / 100.0f,
+                m_duoview_fovea_height->value() / 100.0f,
+                m_duoview_fovea_scale->value() / 100.0f,
+                m_duoview_periphery_scale->value() / 100.0f,
+                m_duoview_vertical_center->value() / 100.0f,
+                m_duoview_feather_pixels->value(),
+            };
+            m_native_duoview_snapshot_frame = engine_frame;
+        }
+        return m_native_duoview_snapshot;
+    }
+
     bool is_native_stereo_fix_same_pass_enabled() const {
         if (should_force_native_stereo_fix_same_pass()) {
             return true;
@@ -1903,6 +1926,15 @@ private:
     const ModToggle::Ptr m_ghosting_fix{ ModToggle::create(generate_name("GhostingFix"), false) };
     const ModToggle::Ptr m_ghosting_fix_bootstrap_view_states{ ModToggle::create(generate_name("GhostingFixBootstrapViewStates"), false) };
     const ModToggle::Ptr m_native_stereo_fix{ ModToggle::create(generate_name("NativeStereoFix"), false) };
+    const ModSlider::Ptr m_duoview_fovea_width{ ModSlider::create(generate_name("DuoViewFoveaWidth"), 20.0f, 100.0f, 50.0f) };
+    const ModSlider::Ptr m_duoview_fovea_height{ ModSlider::create(generate_name("DuoViewFoveaHeight"), 20.0f, 100.0f, 50.0f) };
+    const ModSlider::Ptr m_duoview_fovea_scale{ ModSlider::create(generate_name("DuoViewFoveaScale"), 20.0f, 100.0f, 100.0f) };
+    const ModSlider::Ptr m_duoview_periphery_scale{ ModSlider::create(generate_name("DuoViewPeripheryScale"), 20.0f, 100.0f, 30.0f) };
+    const ModSlider::Ptr m_duoview_vertical_center{ ModSlider::create(generate_name("DuoViewVerticalCenter"), 0.0f, 100.0f, 50.0f) };
+    const ModSlider::Ptr m_duoview_feather_pixels{ ModSlider::create(generate_name("DuoViewFeatherPixels"), 0.0f, 256.0f, 8.0f) };
+    std::mutex m_native_duoview_snapshot_mtx{};
+    uint32_t m_native_duoview_snapshot_frame{std::numeric_limits<uint32_t>::max()};
+    uevr::duoview::Parameters m_native_duoview_snapshot{};
     const ModToggle::Ptr m_native_stereo_fix_same_pass{ ModToggle::create(generate_name("NativeStereoFixSamePass"), true) };
     const ModToggle::Ptr m_native_stereo_fix_preserve_secondary_pass{ ModToggle::create(generate_name("NativeStereoFixPreserveSecondaryPass"), true) };
     const ModToggle::Ptr m_native_stereo_fix_texture_array_submit{ ModToggle::create(generate_name("NativeStereoFixTextureArraySubmit"), false) };
@@ -2387,6 +2419,12 @@ public:
             *m_ghosting_fix,
             *m_ghosting_fix_bootstrap_view_states,
             *m_native_stereo_fix,
+            *m_duoview_fovea_width,
+            *m_duoview_fovea_height,
+            *m_duoview_fovea_scale,
+            *m_duoview_periphery_scale,
+            *m_duoview_vertical_center,
+            *m_duoview_feather_pixels,
             *m_native_stereo_fix_same_pass,
             *m_native_stereo_fix_preserve_secondary_pass,
             *m_native_stereo_fix_texture_array_submit,
diff --git a/src/mods/vr/DuoViewGeometry.hpp b/src/mods/vr/DuoViewGeometry.hpp
index 61f467f4..dce7fc4a 100644
--- a/src/mods/vr/DuoViewGeometry.hpp
+++ b/src/mods/vr/DuoViewGeometry.hpp
@@ -31,6 +31,7 @@ struct Rect {
 };
 
 struct Geometry {
+    Extent reference{};
     Rect crop{};
     Extent fovea{};
     Extent periphery{};
@@ -71,6 +72,7 @@ inline bool calculate(uint32_t width, uint32_t height, Extent fovea_allocation,
     if (right <= left || bottom <= top) { return false; }
 
     Geometry result{};
+    result.reference = {width, height};
     result.crop = {left, top, right, bottom};
     result.u0 = static_cast<float>(left) / width;
     result.v0 = static_cast<float>(top) / height;
diff --git a/src/mods/vr/FFakeStereoRenderingHook.cpp b/src/mods/vr/FFakeStereoRenderingHook.cpp
index 42858980..c878c7ac 100644
--- a/src/mods/vr/FFakeStereoRenderingHook.cpp
+++ b/src/mods/vr/FFakeStereoRenderingHook.cpp
@@ -25967,6 +25967,13 @@ void FFakeStereoRenderingHook::begin_render_viewfamily_real(void* render_module,
         packet->player_index = native_left_metadata.player_index;
         packet->left_pass = native_left_metadata.original_stereo_pass;
         packet->right_pass = native_right_metadata.original_stereo_pass;
+        packet->left_view_rect = native_left_metadata.view_rect;
+        packet->right_view_rect = native_right_metadata.view_rect;
+        packet->duoview = vr->is_native_duoview_active();
+        packet->duoview_parameters = packet->duoview
+            ? vr->native_duoview_parameters_for_frame(g_frame_count)
+            : uevr::duoview::Parameters{};
+        packet->duoview_projections_valid = native_left_metadata.projection_valid && native_right_metadata.projection_valid;
         if (stalker_primary_frame && stalker_secondary_frame) {
             packet->stalker_key = uevr::stalker2_native::make_key(stalker_epoch,
                 *stalker_primary_frame, *stalker_secondary_frame, g_hook->get_frame_delay_compensation());
@@ -29926,6 +29933,22 @@ void FFakeStereoRenderingHook::adjust_view_rect(FFakeStereoRendering* stereo, in
         ? index - 1
         : (index_starts_from_one ? ((index + 1) % 2) : (index % 2));
 
+    if (VR::get()->is_native_duoview_active()) {
+        const auto parameters = VR::get()->native_duoview_parameters_for_frame(g_frame_count);
+        uevr::duoview::Geometry geometry{};
+        const auto width = VR::get()->get_hmd_width();
+        const auto height = VR::get()->get_hmd_height();
+        if (uevr::duoview::calculate(width, height, {width, height}, {width, height}, parameters, geometry)) {
+            *x = 0;
+            *y = 0;
+            const auto source = true_index == 0 ? geometry.fovea : geometry.periphery;
+            *w = source.width;
+            *h = source.height;
+            return;
+        }
+        SPDLOG_WARNING_EVERY_N_SEC(2, "[DuoView] Keeping the baseline source view rectangle because the live geometry snapshot is invalid");
+    }
+
     if (medium_one_based_eye_pass) {
         SPDLOG_INFO_ONCE("[Medium][UE4.25Plus] Forcing one-based stereo eye passes (1=left, 2=right)");
     }
@@ -30020,6 +30043,7 @@ __forceinline void FFakeStereoRenderingHook::calculate_stereo_view_offset(
     const auto rot_d = (Rotator<double>*)view_rotation;
 
     const bool mono = vr->is_using_mono();
+    const bool duoview = vr->is_native_duoview_active();
     if (mono && !is_full_pass) { true_index = 0; }
     if (vr->is_using_afr() && !is_full_pass) {
         true_index = g_frame_count % 2;
@@ -30249,9 +30273,10 @@ __forceinline void FFakeStereoRenderingHook::calculate_stereo_view_offset(
         const auto rotation_offset = vr->get_rotation_offset();
         const auto current_hmd_rotation = glm::normalize(rotation_offset * glm::quat{vr->get_rotation(0)});
         const auto current_eye_rotation_offset = glm::normalize(glm::quat{vr->get_eye_transform(true_index)});
+        const auto source_eye_rotation_offset = duoview ? glm::quat{1.0f, 0.0f, 0.0f, 0.0f} : current_eye_rotation_offset;
 
-        const auto new_rotation = glm::normalize(vqi_norm * current_hmd_rotation * current_eye_rotation_offset);
-        const auto eye_offset = mono
+        const auto new_rotation = glm::normalize(vqi_norm * current_hmd_rotation * source_eye_rotation_offset);
+        const auto eye_offset = (mono || duoview)
             ? (glm::vec3{vr->get_eye_offset(VRRuntime::Eye::LEFT)} + glm::vec3{vr->get_eye_offset(VRRuntime::Eye::RIGHT)}) * 0.5f
             : glm::vec3{vr->get_eye_offset((VRRuntime::Eye)(true_index))};
 
@@ -30266,7 +30291,7 @@ __forceinline void FFakeStereoRenderingHook::calculate_stereo_view_offset(
         const auto head_offset_flat = quat_converter * (vqi_norm * (pos_flat * world_scale));
         // Mono's center is expressed in head space; its optical rotation must
         // not rotate the translation a second time on calibrated/canted HMDs.
-        const auto eye_translation_rotation = mono ? glm::normalize(vqi_norm * current_hmd_rotation) : glm::normalize(new_rotation);
+        const auto eye_translation_rotation = (mono || duoview) ? glm::normalize(vqi_norm * current_hmd_rotation) : glm::normalize(new_rotation);
         const auto eye_separation = quat_converter * (eye_translation_rotation * (eye_offset * world_scale));
 
         if (trace_view) {
@@ -30652,11 +30677,13 @@ __forceinline Matrix4x4f* FFakeStereoRenderingHook::calculate_stereo_projection_
         auto true_index = medium_one_based_projection_pass
             ? view_index - 1
             : (index_starts_from_one ? ((view_index + 1) % 2) : (view_index % 2));
+        const auto source_index = true_index;
+        const auto duoview = vr->is_native_duoview_active();
     
         if (vr->is_using_afr()) {
             true_index = g_frame_count % 2;
         }
-        if (vr->is_using_mono()) { true_index = 0; }
+        if (vr->is_using_mono() || duoview) { true_index = 0; }
 
         auto& double_matrix = *(Matrix4x4d*)out;
 
@@ -30676,6 +30703,21 @@ __forceinline Matrix4x4f* FFakeStereoRenderingHook::calculate_stereo_projection_
             const auto fmat = VR::get()->get_projection_matrix((VRRuntime::Eye)(true_index));
             double_matrix = fmat;
         }
+        if (duoview && source_index == 0) {
+            const auto parameters = vr->native_duoview_parameters_for_frame(g_frame_count);
+            const auto width = vr->get_hmd_width();
+            const auto height = vr->get_hmd_height();
+            uevr::duoview::Geometry geometry{};
+            if (uevr::duoview::calculate(width, height, {width, height}, {width, height}, parameters, geometry)) {
+                if (!g_hook->m_has_double_precision) {
+                    uevr::duoview::crop_projection(*out, geometry);
+                } else {
+                    uevr::duoview::crop_projection(double_matrix, geometry);
+                }
+            } else {
+                SPDLOG_WARNING_EVERY_N_SEC(2, "[DuoView] Keeping the baseline projection because the live geometry snapshot is invalid");
+            }
+        }
         if (vr->mono_frame_gate_required() && vr->get_runtime()->is_openxr()) {
             vr->get_openxr_runtime()->note_mono_projection();
         }
