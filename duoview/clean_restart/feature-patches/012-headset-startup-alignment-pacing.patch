+// The runtime projection is column-major. Project view-forward (+Z) through
+// the actual source matrix so an asymmetric frustum centers the crop on its
+// forward ray rather than assuming that ray is at texture UV (0.5, 0.5).
+template <class Matrix>
+inline bool projection_center(const Matrix& matrix, Center& out) {
+    const auto clip_w = static_cast<double>(matrix[2][3]) + static_cast<double>(matrix[3][3]);
+    if (!std::isfinite(clip_w) || std::abs(clip_w) <= 1.0e-12) { return false; }
+    const auto ndc_x = (static_cast<double>(matrix[2][0]) + static_cast<double>(matrix[3][0])) / clip_w;
+    const auto ndc_y = (static_cast<double>(matrix[2][1]) + static_cast<double>(matrix[3][1])) / clip_w;
+    const auto x = 0.5 * (ndc_x + 1.0);
+    const auto y = 0.5 * (1.0 - ndc_y);
+    if (!std::isfinite(x) || !std::isfinite(y) || x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0) {
+        return false;
+    }
+    out = {static_cast<float>(x), static_cast<float>(y)};
+    return true;
