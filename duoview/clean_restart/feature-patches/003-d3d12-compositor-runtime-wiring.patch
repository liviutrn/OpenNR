+cbuffer Params : register(b0) {
+    float4 FoveaUV;
+    float4 PeripheryUV;
+    float4 CropUV;
+    float4 Output;
+};
+struct Vertex { float4 position : SV_Position; float2 uv : TEXCOORD0; };
+Vertex VS(uint id : SV_VertexID) {
+    const float2 p = float2((id << 1) & 2, id & 2);
+    Vertex v;
+    v.position = float4(p * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+    v.uv = p;
+    return v;
+}
+float4 PS(Vertex v) : SV_Target {
+    const float2 uv = saturate(v.uv);
+    const float4 peripheral = Periphery.Sample(LinearClamp, lerp(PeripheryUV.xy, PeripheryUV.zw, uv));
+    if (uv.x < CropUV.x || uv.x > CropUV.z || uv.y < CropUV.y || uv.y > CropUV.w) {
+        return peripheral;
+    }
+    const float2 local_uv = saturate((uv - CropUV.xy) / max(CropUV.zw - CropUV.xy, 1.0e-6));
+    const float4 fovea = Fovea.Sample(LinearClamp, lerp(FoveaUV.xy, FoveaUV.zw, local_uv));
+    if (Output.z <= 0.0) {
+        return fovea;
+    }
+    const float2 edge_pixels = min(uv - CropUV.xy, CropUV.zw - uv) * Output.xy;
+    const float edge = min(edge_pixels.x, edge_pixels.y);
+    const float blend = smoothstep(0.0, Output.z, edge);
+    return lerp(peripheral, fovea, blend);
+}
+)";
+
+bool is_bgra(DXGI_FORMAT format) {
+    return format == DXGI_FORMAT_B8G8R8A8_TYPELESS ||
+        format == DXGI_FORMAT_B8G8R8A8_UNORM ||
+        format == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
+}
+
+DXGI_FORMAT view_format(DXGI_FORMAT format) {
+    return format == DXGI_FORMAT_B8G8R8A8_TYPELESS ? DXGI_FORMAT_B8G8R8A8_UNORM : format;
+}
+
+bool valid_texture(ID3D12Resource* texture, ID3D12Device* device, bool output) {
+    if (texture == nullptr || device == nullptr) { return false; }
+    const auto desc = texture->GetDesc();
+    ComPtr<ID3D12Device> owner{};
+    if (FAILED(texture->GetDevice(IID_PPV_ARGS(&owner))) || owner.Get() != device ||
+        desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || desc.Width == 0 || desc.Height == 0 ||
+        desc.DepthOrArraySize != 1 || desc.MipLevels != 1 || desc.SampleDesc.Count != 1 || desc.SampleDesc.Quality != 0 ||
+        !is_bgra(desc.Format)) {
+        return false;
+    }
+    if (output) {
+        return (desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET) != 0;
+    }
+    return (desc.Flags & D3D12_RESOURCE_FLAG_DENY_SHADER_RESOURCE) == 0;
+}
+
+bool valid_rect(SourceRect rect, const D3D12_RESOURCE_DESC& desc) {
+    return rect.left >= 0 && rect.top >= 0 && rect.right > rect.left && rect.bottom > rect.top &&
+        static_cast<uint64_t>(rect.right) <= desc.Width && static_cast<uint64_t>(rect.bottom) <= desc.Height;
+}
+
+std::array<float, 4> normalized_rect(SourceRect rect, const D3D12_RESOURCE_DESC& desc) {
+    const auto width = static_cast<float>(desc.Width);
+    const auto height = static_cast<float>(desc.Height);
+    return {
+        (static_cast<float>(rect.left) + 0.5f) / width,
+        (static_cast<float>(rect.top) + 0.5f) / height,
+        (static_cast<float>(rect.right) - 0.5f) / width,
+        (static_cast<float>(rect.bottom) - 0.5f) / height,
+    };
+}
+
+} // namespace
+
+struct D3D12Compositor::OutputSlot {
+    ComPtr<ID3D12Resource> destination{};
+    ComPtr<ID3D12Resource> fovea{};
+    ComPtr<ID3D12Resource> periphery{};
+    ComPtr<ID3D12DescriptorHeap> srvs{};
+    ComPtr<ID3D12DescriptorHeap> rtv{};
+    UINT srv_stride{};
+    D3D12_CPU_DESCRIPTOR_HANDLE rtv_handle{};
+    DXGI_FORMAT rtv_format{DXGI_FORMAT_UNKNOWN};
+};
+
+bool D3D12Compositor::ensure_pipeline(ID3D12Device* device) {
+    if (device == nullptr) { return false; }
+    if (m_device.Get() == device && m_root_signature != nullptr && m_unorm_pipeline != nullptr && m_srgb_pipeline != nullptr) {
+        return true;
+    }
+    if (m_device != nullptr) { return false; }
+
+    ComPtr<ID3DBlob> vertex_shader{};
+    ComPtr<ID3DBlob> pixel_shader{};
+    if (FAILED(D3DCompile(shader, sizeof(shader) - 1, "Native DuoView", nullptr, nullptr, "VS", "vs_5_0",
+            D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &vertex_shader, nullptr)) ||
+        FAILED(D3DCompile(shader, sizeof(shader) - 1, "Native DuoView", nullptr, nullptr, "PS", "ps_5_0",
+            D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &pixel_shader, nullptr))) {
+        return false;
+    }
+
+    const D3D12_DESCRIPTOR_RANGE range{D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 2, 0, 0, 0};
+    D3D12_ROOT_PARAMETER parameters[2]{};
+    parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    parameters[0].DescriptorTable = {1, &range};
+    parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    parameters[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    parameters[1].Constants = {0, 0, 16};
+    parameters[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+
+    D3D12_STATIC_SAMPLER_DESC sampler{};
+    sampler.Filter = D3D12_FILTER_MIN_MAG_MIP_LINEAR;
+    sampler.AddressU = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.AddressV = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.AddressW = D3D12_TEXTURE_ADDRESS_MODE_CLAMP;
+    sampler.ComparisonFunc = D3D12_COMPARISON_FUNC_NEVER;
+    sampler.MaxLOD = D3D12_FLOAT32_MAX;
+    sampler.ShaderVisibility = D3D12_SHADER_VISIBILITY_PIXEL;
+    const D3D12_ROOT_SIGNATURE_DESC signature{
+        2, parameters, 1, &sampler, D3D12_ROOT_SIGNATURE_FLAG_NONE};
+
+    ComPtr<ID3DBlob> serialized{};
+    if (FAILED(D3D12SerializeRootSignature(&signature, D3D_ROOT_SIGNATURE_VERSION_1, &serialized, nullptr))) {
+        return false;
+    }
+    ComPtr<ID3D12RootSignature> root{};
+    if (FAILED(device->CreateRootSignature(0, serialized->GetBufferPointer(), serialized->GetBufferSize(), IID_PPV_ARGS(&root)))) {
+        return false;
+    }
+
+    auto create_pipeline = [&](DXGI_FORMAT format, ComPtr<ID3D12PipelineState>& result) {
+        D3D12_GRAPHICS_PIPELINE_STATE_DESC desc{};
+        desc.pRootSignature = root.Get();
+        desc.VS = {vertex_shader->GetBufferPointer(), vertex_shader->GetBufferSize()};
+        desc.PS = {pixel_shader->GetBufferPointer(), pixel_shader->GetBufferSize()};
+        desc.BlendState.RenderTarget[0].RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+        desc.SampleMask = UINT_MAX;
+        desc.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+        desc.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+        desc.RasterizerState.DepthClipEnable = TRUE;
+        desc.DepthStencilState.DepthEnable = FALSE;
+        desc.DepthStencilState.StencilEnable = FALSE;
+        desc.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+        desc.NumRenderTargets = 1;
+        desc.RTVFormats[0] = format;
+        desc.SampleDesc.Count = 1;
+        return SUCCEEDED(device->CreateGraphicsPipelineState(&desc, IID_PPV_ARGS(&result)));
+    };
+
+    ComPtr<ID3D12PipelineState> unorm{};
+    ComPtr<ID3D12PipelineState> srgb{};
+    if (!create_pipeline(DXGI_FORMAT_B8G8R8A8_UNORM, unorm) ||
+        !create_pipeline(DXGI_FORMAT_B8G8R8A8_UNORM_SRGB, srgb)) {
+        return false;
+    }
+
+    m_device = device;
+    m_root_signature = std::move(root);
+    m_unorm_pipeline = std::move(unorm);
+    m_srgb_pipeline = std::move(srgb);
+    return true;
+}
+
+bool D3D12Compositor::record_double_wide(
+    ID3D12Device* device, ID3D12GraphicsCommandList* command_list,
+    ID3D12Resource* fovea, ID3D12Resource* periphery,
+    SourceRect fovea_rect, SourceRect periphery_rect, const Geometry& geometry,
+    D3D12_RESOURCE_STATES source_state, ID3D12Resource* destination,
+    D3D12_RESOURCE_STATES destination_state)
+{
+    return record(device, command_list, fovea, periphery, fovea_rect, periphery_rect,
+        geometry, source_state, destination, destination_state, 2);
+}
+
+bool D3D12Compositor::record_eye(
+    ID3D12Device* device, ID3D12GraphicsCommandList* command_list,
+    ID3D12Resource* fovea, ID3D12Resource* periphery,
+    SourceRect fovea_rect, SourceRect periphery_rect, const Geometry& geometry,
+    D3D12_RESOURCE_STATES source_state, ID3D12Resource* destination,
+    D3D12_RESOURCE_STATES destination_state)
+{
+    return record(device, command_list, fovea, periphery, fovea_rect, periphery_rect,
+        geometry, source_state, destination, destination_state, 1);
+}
+
+bool D3D12Compositor::record(
+    ID3D12Device* device, ID3D12GraphicsCommandList* command_list,
+    ID3D12Resource* fovea, ID3D12Resource* periphery,
+    SourceRect fovea_rect, SourceRect periphery_rect, const Geometry& geometry,
+    D3D12_RESOURCE_STATES source_state, ID3D12Resource* destination,
+    D3D12_RESOURCE_STATES destination_state, uint32_t eye_count)
+{
+    if (command_list == nullptr || fovea == nullptr || periphery == nullptr || destination == nullptr ||
+        fovea == periphery || destination == fovea || destination == periphery ||
+        geometry.reference.width == 0 || geometry.reference.height == 0 ||
+        !std::isfinite(geometry.u0) || !std::isfinite(geometry.v0) ||
+        !std::isfinite(geometry.u1) || !std::isfinite(geometry.v1) ||
+        geometry.u0 < 0.0f || geometry.v0 < 0.0f || geometry.u1 > 1.0f || geometry.v1 > 1.0f ||
+        geometry.u1 <= geometry.u0 || geometry.v1 <= geometry.v0 ||
+        !std::isfinite(geometry.feather_pixels) || geometry.feather_pixels < 0.0f ||
+        !valid_texture(fovea, device, false) || !valid_texture(periphery, device, false) ||
+        !valid_texture(destination, device, true)) {
+        return false;
+    }
+
+    const auto fovea_desc = fovea->GetDesc();
+    const auto periphery_desc = periphery->GetDesc();
+    const auto destination_desc = destination->GetDesc();
+    if (!valid_rect(fovea_rect, fovea_desc) || !valid_rect(periphery_rect, periphery_desc) ||
+        (eye_count == 2 && (destination_desc.Width < 2 || (destination_desc.Width % 2) != 0))) {
+        return false;
+    }
+    if (!ensure_pipeline(device)) { return false; }
+
+    auto slot_it = m_outputs.find(destination);
+    if (slot_it == m_outputs.end()) {
+        auto slot = std::make_unique<OutputSlot>();
+        slot->destination = destination;
+        D3D12_DESCRIPTOR_HEAP_DESC srv_heap_desc{};
+        srv_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV;
+        srv_heap_desc.NumDescriptors = 2;
+        srv_heap_desc.Flags = D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE;
+        D3D12_DESCRIPTOR_HEAP_DESC rtv_heap_desc{};
+        rtv_heap_desc.Type = D3D12_DESCRIPTOR_HEAP_TYPE_RTV;
+        rtv_heap_desc.NumDescriptors = 1;
+        if (FAILED(device->CreateDescriptorHeap(&srv_heap_desc, IID_PPV_ARGS(&slot->srvs))) ||
+            FAILED(device->CreateDescriptorHeap(&rtv_heap_desc, IID_PPV_ARGS(&slot->rtv)))) {
+            return false;
+        }
+        slot->srv_stride = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        slot->rtv_handle = slot->rtv->GetCPUDescriptorHandleForHeapStart();
+        slot->rtv_format = view_format(destination_desc.Format);
+        D3D12_RENDER_TARGET_VIEW_DESC rtv_desc{};
+        rtv_desc.Format = slot->rtv_format;
+        rtv_desc.ViewDimension = D3D12_RTV_DIMENSION_TEXTURE2D;
+        rtv_desc.Texture2D.MipSlice = 0;
+        rtv_desc.Texture2D.PlaneSlice = 0;
+        device->CreateRenderTargetView(destination, &rtv_desc, slot->rtv_handle);
+        slot_it = m_outputs.emplace(destination, std::move(slot)).first;
+    }
+
+    auto& slot = *slot_it->second;
+    if (slot.fovea.Get() != fovea || slot.periphery.Get() != periphery) {
+        const D3D12_CPU_DESCRIPTOR_HANDLE first_srv = slot.srvs->GetCPUDescriptorHandleForHeapStart();
+        D3D12_CPU_DESCRIPTOR_HANDLE second_srv = first_srv;
+        second_srv.ptr += slot.srv_stride;
+        D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc{};
+        srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        srv_desc.Texture2D.MostDetailedMip = 0;
+        srv_desc.Texture2D.MipLevels = 1;
+        srv_desc.Format = view_format(fovea_desc.Format);
+        device->CreateShaderResourceView(fovea, &srv_desc, first_srv);
+        srv_desc.Format = view_format(periphery_desc.Format);
+        device->CreateShaderResourceView(periphery, &srv_desc, second_srv);
+        slot.fovea = fovea;
+        slot.periphery = periphery;
+    }
+
+    const auto fovea_uv = normalized_rect(fovea_rect, fovea_desc);
+    const auto periphery_uv = normalized_rect(periphery_rect, periphery_desc);
+    std::array<float, 16> constants{
+        fovea_uv[0], fovea_uv[1], fovea_uv[2], fovea_uv[3],
+        periphery_uv[0], periphery_uv[1], periphery_uv[2], periphery_uv[3],
+        geometry.u0, geometry.v0, geometry.u1, geometry.v1,
+        0.0f, 0.0f, geometry.feather_pixels, 0.0f,
+    };
+    const auto eye_width = static_cast<UINT>(eye_count == 2 ? destination_desc.Width / 2 : destination_desc.Width);
+    const auto output_height = static_cast<UINT>(destination_desc.Height);
+    if (eye_width == 0 || output_height == 0) { return false; }
+    constants[12] = static_cast<float>(eye_width);
+    constants[13] = static_cast<float>(output_height);
+
+    std::array<D3D12_RESOURCE_BARRIER, 3> barriers{};
+    UINT barrier_count{};
+    auto add_transition = [&](ID3D12Resource* resource, D3D12_RESOURCE_STATES before, D3D12_RESOURCE_STATES after) {
+        if (before == after) { return; }
+        auto& barrier = barriers[barrier_count++];
+        barrier.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+        barrier.Transition.pResource = resource;
+        barrier.Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        barrier.Transition.StateBefore = before;
+        barrier.Transition.StateAfter = after;
+    };
+    add_transition(fovea, source_state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    add_transition(periphery, source_state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    add_transition(destination, destination_state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    if (barrier_count != 0) { command_list->ResourceBarrier(barrier_count, barriers.data()); }
+
+    command_list->SetGraphicsRootSignature(m_root_signature.Get());
+    command_list->SetPipelineState(slot.rtv_format == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB
+        ? m_srgb_pipeline.Get() : m_unorm_pipeline.Get());
+    ID3D12DescriptorHeap* heaps[]{slot.srvs.Get()};
+    command_list->SetDescriptorHeaps(1, heaps);
+    command_list->SetGraphicsRootDescriptorTable(0, slot.srvs->GetGPUDescriptorHandleForHeapStart());
+    command_list->SetGraphicsRoot32BitConstants(1, static_cast<UINT>(constants.size()), constants.data(), 0);
+    command_list->IASetPrimitiveTopology(D3D_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    command_list->OMSetRenderTargets(1, &slot.rtv_handle, FALSE, nullptr);
+
+    const auto eye_count_safe = std::min(eye_count, 2u);
+    for (uint32_t eye = 0; eye < eye_count_safe; ++eye) {
+        const auto x = static_cast<UINT>(eye * eye_width);
+        const D3D12_VIEWPORT viewport{static_cast<float>(x), 0.0f, static_cast<float>(eye_width), static_cast<float>(output_height), 0.0f, 1.0f};
+        const D3D12_RECT scissor{static_cast<LONG>(x), 0, static_cast<LONG>(x + eye_width), static_cast<LONG>(output_height)};
+        command_list->RSSetViewports(1, &viewport);
+        command_list->RSSetScissorRects(1, &scissor);
+        command_list->DrawInstanced(3, 1, 0, 0);
+    }
+
+    barrier_count = 0;
+    add_transition(destination, D3D12_RESOURCE_STATE_RENDER_TARGET, destination_state);
+    add_transition(periphery, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, source_state);
+    add_transition(fovea, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE, source_state);
+    if (barrier_count != 0) { command_list->ResourceBarrier(barrier_count, barriers.data()); }
+    return true;
+}
+
+void D3D12Compositor::reset() {
+    m_outputs.clear();
+    m_srgb_pipeline.Reset();
+    m_unorm_pipeline.Reset();
+    m_root_signature.Reset();
+    m_device.Reset();
+}
+
+} // namespace uevr::duoview
