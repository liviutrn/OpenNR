+        ID3D12Device* device,
+        ID3D12GraphicsCommandList* command_list,
+        ID3D12Resource* fovea,
+        ID3D12Resource* periphery,
+        SourceRect fovea_rect,
+        SourceRect periphery_rect,
+        const Geometry& geometry,
+        D3D12_RESOURCE_STATES source_state,
+        ID3D12Resource* destination,
+        D3D12_RESOURCE_STATES destination_state);
+
+    void reset();
+
+private:
+    struct OutputSlot;
+
+    bool ensure_pipeline(ID3D12Device* device);
+    bool record(
+        ID3D12Device* device,
+        ID3D12GraphicsCommandList* command_list,
+        ID3D12Resource* fovea,
+        ID3D12Resource* periphery,
+        SourceRect fovea_rect,
+        SourceRect periphery_rect,
+        const Geometry& geometry,
+        D3D12_RESOURCE_STATES source_state,
+        ID3D12Resource* destination,
+        D3D12_RESOURCE_STATES destination_state,
+        uint32_t eye_count);
+
+    Microsoft::WRL::ComPtr<ID3D12Device> m_device{};
+    Microsoft::WRL::ComPtr<ID3D12RootSignature> m_root_signature{};
+    Microsoft::WRL::ComPtr<ID3D12PipelineState> m_unorm_pipeline{};
+    Microsoft::WRL::ComPtr<ID3D12PipelineState> m_srgb_pipeline{};
+    std::unordered_map<ID3D12Resource*, std::unique_ptr<OutputSlot>> m_outputs{};
+};
+
